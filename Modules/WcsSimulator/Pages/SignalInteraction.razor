@page "/wcs-simulator/signal-interaction"
@inject IWcsService WcsService
@inject IJSRuntime Js
@inject LocalStoreService LocalStore
@inject SignalAutoService SignalAuto
@inject TaskLedgerService Ledger
@inject TaskStageHub StageHub
@inject AutomationHub AutoHub
@inject WcsApiClient WcsApi
@inject BackendHealthService Health
@implements IDisposable

<PageTitle>信号交互</PageTitle>

@* ════════════════════════════════════════════════
   提示：WCS 后端地址/GRCS 地址/场景名在「地图信息」页系统设置配置
   ════════════════════════════════════════════════ *@
<div class="hint-text" style="margin:0 0 12px;">
    WCS 后端地址与 GRCS 地址/场景名在「地图信息」页系统设置配置，本页自动读取。
</div>

<div class="section-card">
    <div class="section-header">
        🎛 信号交互
        <span class="hint-text" style="margin:0;">选择类型查看对应信号，卡片网格随数据实时刷新</span>
    </div>

    @* ── 第一行：四个类型卡片，点击切换下方公用展示区 ── *@
    <div class="si-type-grid">
        <button class="si-type-card @(_activeSection == "adm" ? "on" : "")" @onclick='() => SetSection("adm")'>
            <div class="si-type-top">
                <span class="si-type-icon">🚦</span>
                <span class="si-type-name">进入申请</span>
                <span class="badge @(_pendingCount > 0 ? "badge-warn" : "badge-ok") si-type-count">@_pendingCount</span>
            </div>
            <span class="si-type-desc">车辆进站请求审批</span>
        </button>
        <button class="si-type-card @(_activeSection == "arrival" ? "on" : "")" @onclick='() => SetSection("arrival")'>
            <div class="si-type-top">
                <span class="si-type-icon">📦</span>
                <span class="si-type-name">货物到达</span>
                <span class="badge @(_pendingArrival > 0 ? "badge-warn" : "badge-ok") si-type-count">@_pendingArrival</span>
            </div>
            <span class="si-type-desc">入库接驳 container_ready</span>
        </button>
        <button class="si-type-card @(_activeSection == "removal" ? "on" : "")" @onclick='() => SetSection("removal")'>
            <div class="si-type-top">
                <span class="si-type-icon">📤</span>
                <span class="si-type-name">货物移除</span>
                <span class="badge @(_pendingRemoval > 0 ? "badge-warn" : "badge-ok") si-type-count">@_pendingRemoval</span>
            </div>
            <span class="si-type-desc">出库接驳 container_remove</span>
        </button>
        <button class="si-type-card @(_activeSection == "sorting" ? "on" : "")" @onclick='() => SetSection("sorting")'>
            <div class="si-type-top">
                <span class="si-type-icon">🎯</span>
                <span class="si-type-name">分拣信号</span>
                <span class="badge @(_pendingSorting > 0 ? "badge-warn" : "badge-ok") si-type-count">@_pendingSorting</span>
            </div>
            <span class="si-type-desc">分拣完成 operation_finish</span>
        </button>
    </div>

    <div style="min-height:280px;">
    @switch (_activeSection)
    {
        case "adm":
        {
            <div class="tab-toolbar">
                <span class="badge @(AutoHub.AdmittanceAutoMode ? "badge-ok" : "badge-warn")">@(AutoHub.AdmittanceAutoMode ? "自动" : "手动")</span>
                <button class="btn @(AutoHub.AdmittanceAutoMode ? "btn-outline" : "btn-primary") btn-xs"
                        @onclick="ToggleMode" disabled="@_busy">@(AutoHub.AdmittanceAutoMode ? "切换手动" : "切换自动")</button>
                <button class="btn btn-outline btn-sm" @onclick='() => RefreshAdmittanceNow()' disabled="@_busy">🔄 刷新</button>
                <span class="refresh-ok">@_admRefreshMsg</span>
                <span style="flex:1;"></span>
                @if (_admConfirming)
                {
                    <button class="btn btn-danger btn-sm" @onclick="ClearAllEntries">确认</button>
                    <button class="btn btn-outline btn-sm" @onclick='() => _admConfirming = false'>取消</button>
                }
                else
                {
                    <button class="btn btn-danger btn-sm" @onclick='() => _admConfirming = true'>🗑 清空全部</button>
                }
                <span class="clear-ok">@_admClearMsg</span>
            </div>
            @if (!_pollingOk)
            {
                <div class="hint-text" style="color:#f87171;margin:8px 0;">⚠ 无法连接 WCS 后端，请确认 GrcsBackend 已启动。@_lastError</div>
            }
            @if (_events.Count == 0)
            {
                <div class="hint-text" style="margin:8px 0;">暂无申请事件。GRCS 发出 station_entry_request 后会在这里出现。</div>
            }
            else
            {
            <table class="entry-table">
                <thead><tr><th>车辆</th><th>站点</th><th>载货</th><th>申请时间</th><th>下发时间</th><th>请求次数</th><th>状态</th><th>操作</th></tr></thead>
                <tbody>
                    @foreach (var e in _events)
                    {
                        var isPending = e.Status == "Pending";
                        <tr>
                            <td><span class="entry-vehicle">🚗 @e.VehicleCode</span></td>
                            <td>@e.StationCode</td>
                            <td>@(e.IsLoaded ? "载货" : "空车")</td>
                            <td>@e.Time.ToString("HH:mm:ss")</td>
                            <td>@(e.DecidedAt?.ToString("HH:mm:ss") ?? "—")</td>
                            <td>@(e.Attempts > 0 ? $"{e.Attempts} 次" : "")</td>
                            <td><span class="badge @(StatusBadgeClass(e.Status))">@StatusLabel(e.Status)</span></td>
                            <td style="display:flex;gap:4px;align-items:center;">@if (isPending) {<button class="btn btn-primary btn-xs" @onclick="() => Decide(e.Key, true)" disabled="@_busy">批准</button><button class="btn btn-danger btn-xs" @onclick="() => Decide(e.Key, false)" disabled="@_busy">拒绝</button>} else {<span class="hint-text">@(e.Status == "Allowed" ? "已放行" : e.Status == "Approved" ? "等待领取" : "已拒绝")</span>}<button class="btn btn-danger btn-xs" @onclick="() => DeleteEntry(e.Key)" @onclick:stopPropagation style="margin-left:4px;">✕</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            }
            break;
        }

        case "arrival":
        {
            <div class="tab-toolbar">
                <span class="badge @(SignalAuto.ArrivalAuto ? "badge-ok" : "badge-warn")">@(SignalAuto.ArrivalAuto ? "自动" : "手动")</span>
                <button class="btn @(SignalAuto.ArrivalAuto ? "btn-outline" : "btn-primary") btn-xs"
                        @onclick="ToggleArrivalMode" disabled="@_arrivalBusy">@(SignalAuto.ArrivalAuto ? "切换手动" : "切换自动")</button>
                <button class="btn btn-outline btn-sm" @onclick='() => RefreshArrivalsNow()' disabled="@_arrivalBusy">🔄 刷新</button>
                <span class="refresh-ok">@_arrivalRefreshMsg</span>
                <span style="flex:1;"></span>
                @if (_arrivalConfirming)
                {
                    <button class="btn btn-danger btn-sm" @onclick="ClearAllArrivals">确认</button>
                    <button class="btn btn-outline btn-sm" @onclick='() => _arrivalConfirming = false'>取消</button>
                }
                else
                {
                    <button class="btn btn-danger btn-sm" @onclick='() => _arrivalConfirming = true'>🗑 清空全部</button>
                }
                <span class="clear-ok">@_arrivalClearMsg</span>
            </div>
            @if (_cardError != "") { <div class="hint-text" style="color:#f87171;margin:8px 0;">⚠ 卡片加载异常：@_cardError</div> }
            @if (_arrivalCards.Count == 0)
            {
                <div class="hint-text">暂无</div>
            }
            else
            {
            <table class="entry-table"><thead><tr><th>输送线</th><th>任务号</th><th>容器</th><th>仓库</th><th>申请时间</th><th>下发时间</th><th>操作</th><th>删除</th></tr></thead><tbody>
            @foreach (var c in _arrivalCards)
            {
                <tr>
                    <td><span class="entry-vehicle">🏭 @c.ConveyorCode</span></td>
                    <td>@c.TaskId</td>
                    <td>@c.ContainerCode</td>
                    <td>@c.Warehouse</td>
                    <td>@(c.AppliedAt?.ToString("HH:mm:ss") ?? "—")</td>
                    <td>@(c.SendAt?.ToString("HH:mm:ss") ?? "—")</td>
                    <td>@if (!c.Confirmed) {<button class="btn btn-primary btn-xs" @onclick="() => ConfirmArrival(c)" disabled="@_arrivalBusy">确认</button>} else {<span class="badge badge-ok">已确认</span>}</td>
                    <td><button class="btn btn-danger btn-xs" @onclick="() => DeleteArrival(c)" @onclick:stopPropagation>✕</button></td>
                </tr>
            }
            </tbody></table>
            }
            @if (_deletedArrivalTasks.Count > 0)
            {
                <div class="hint-text" style="margin:8px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span>🗑 已删除</span>
                    <button class="btn btn-outline btn-xs" @onclick="RestoreAllArrivals">恢复全部</button>
                    @foreach (var id in _deletedArrivalTasks)
                    {
                        <span style="display:inline-flex;align-items:center;gap:4px;">
                            <code>@id</code>
                            <button class="btn btn-outline btn-xs" @onclick="() => RestoreArrival(id)">恢复</button>
                        </span>
                    }
                </div>
            }
            break;
        }

        case "removal":
        {
            <div class="tab-toolbar">
                <span class="badge @(SignalAuto.RemovalAuto ? "badge-ok" : "badge-warn")">@(SignalAuto.RemovalAuto ? "自动" : "手动")</span>
                <button class="btn @(SignalAuto.RemovalAuto ? "btn-outline" : "btn-primary") btn-xs"
                        @onclick="ToggleRemovalMode" disabled="@_removalBusy">@(SignalAuto.RemovalAuto ? "切换手动" : "切换自动")</button>
                <button class="btn btn-outline btn-sm" @onclick='() => RefreshRemovalsNow()' disabled="@_removalBusy">🔄 刷新</button>
                <span class="refresh-ok">@_removalRefreshMsg</span>
                <span style="flex:1;"></span>
                @if (_removalConfirming)
                {
                    <button class="btn btn-danger btn-sm" @onclick="ClearAllRemovals">确认</button>
                    <button class="btn btn-outline btn-sm" @onclick='() => _removalConfirming = false'>取消</button>
                }
                else
                {
                    <button class="btn btn-danger btn-sm" @onclick='() => _removalConfirming = true'>🗑 清空全部</button>
                }
                <span class="clear-ok">@_removalClearMsg</span>
            </div>
            @if (_cardError != "") { <div class="hint-text" style="color:#f87171;margin:8px 0;">⚠ 卡片加载异常：@_cardError</div> }
            @if (_removalCards.Count == 0)
            {
                <div class="hint-text">暂无</div>
            }
            else
            {
            <table class="entry-table"><thead><tr><th>接驳位</th><th>任务号</th><th>容器</th><th>仓库</th><th>申请时间</th><th>下发时间</th><th>操作</th><th>删除</th></tr></thead><tbody>
            @foreach (var c in _removalCards)
            {
                <tr>
                    <td><span class="entry-vehicle">🏭 @c.ConveyorCode</span></td>
                    <td>@c.TaskId</td>
                    <td>@c.ContainerCode</td>
                    <td>@c.Warehouse</td>
                    <td>@(c.AppliedAt?.ToString("HH:mm:ss") ?? "—")</td>
                    <td>@(c.SendAt?.ToString("HH:mm:ss") ?? "—")</td>
                    <td>@if (!c.Confirmed) {<button class="btn btn-primary btn-xs" @onclick="() => ConfirmRemoval(c)" disabled="@_removalBusy">确认</button>} else {<span class="badge badge-ok">已确认</span>}</td>
                    <td><button class="btn btn-danger btn-xs" @onclick="() => DeleteRemoval(c)" @onclick:stopPropagation>✕</button></td>
                </tr>
            }
            </tbody></table>
            }
            @if (_deletedRemovalTasks.Count > 0)
            {
                <div class="hint-text" style="margin:8px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span>🗑 已删除</span>
                    <button class="btn btn-outline btn-xs" @onclick="RestoreAllRemovals">恢复全部</button>
                    @foreach (var id in _deletedRemovalTasks)
                    {
                        <span style="display:inline-flex;align-items:center;gap:4px;">
                            <code>@id</code>
                            <button class="btn btn-outline btn-xs" @onclick="() => RestoreRemoval(id)">恢复</button>
                        </span>
                    }
                </div>
            }
            break;
        }

        case "sorting":
        {
            <div class="tab-toolbar">
                <span class="badge @(SignalAuto.AutoSend ? "badge-ok" : "badge-warn")">@(SignalAuto.AutoSend ? "自动" : "手动")</span>
                <button class="btn @(SignalAuto.AutoSend ? "btn-outline" : "btn-primary") btn-xs"
                        @onclick="ToggleAutoSend" disabled="@_busy">@(SignalAuto.AutoSend ? "切换手动" : "切换自动")</button>
                <button class="btn btn-outline btn-sm" @onclick='() => RefreshSortingNow()' disabled="@_busy">🔄 刷新</button>
                <span class="refresh-ok">@_sortingRefreshMsg</span>
                <span style="flex:1;"></span>
                @if (_sortingConfirming)
                {
                    <button class="btn btn-danger btn-sm" @onclick="DeleteAllCards">确认</button>
                    <button class="btn btn-outline btn-sm" @onclick='() => _sortingConfirming = false'>取消</button>
                }
                else
                {
                    <button class="btn btn-danger btn-sm" @onclick='() => _sortingConfirming = true'>🗑 清空全部</button>
                }
                <span class="clear-ok">@_sortingClearMsg</span>
            </div>
            <div class="hint-text" style="margin-bottom:8px;">全自动：轮询发现 FINISHED 立即发 container_operation_finish 给 GRCS；手动：生成卡片等你点发送。</div>
            @if (!_pollingOk) { <div class="hint-text" style="color:#f87171;margin:8px 0;">⚠ 无法连接 WCS 后端。@_lastError</div> }
            @if (_cards.Count == 0)
            {
                <div class="hint-text">暂无分拣完成卡片。任务上报 FINISHED 且站点是分拣台时自动生成。</div>
            }
            else
            {
            <table class="entry-table">
                <thead><tr><th>分拣台</th><th>任务号</th><th>容器</th><th>仓库</th><th>申请时间</th><th>下发时间</th><th>回库任务号</th><th>容器出场</th><th>推荐目的地</th><th>推荐区域</th><th>状态</th><th>操作</th></tr></thead>
                <tbody>
                @foreach (var card in _cards)
                {
                    var isSent = card.Status == "Sent";
                    <tr>
                        <td><span class="entry-vehicle">🎯 @card.PickStation</span></td>
                        <td>@card.TaskId @if (!string.IsNullOrEmpty(card.TaskType)) { <span class="badge badge-selected">@card.TaskType</span> }</td>
                        <td>@card.ContainerCode</td>
                        <td>@card.Warehouse</td>
                        <td>@card.FoundAt.ToString("HH:mm:ss")</td>
                        <td>@(card.SendTime?.ToString("HH:mm:ss") ?? "—")</td>
                        <td>@(string.IsNullOrEmpty(card.ReturnTaskId) ? "—" : card.ReturnTaskId)</td>
                        <td>@(card.RemoveContainer ? "🚪 出场" : "否")</td>
                        <td>@(string.IsNullOrEmpty(card.DestStation) ? "—" : card.DestStation)</td>
                        <td>@(string.IsNullOrEmpty(card.DestArea) ? "—" : card.DestArea)</td>
                        <td><span class="badge @(CardBadgeClass(card.Status))">@CardStatusLabel(card.Status)</span></td>
                        <td style="display:flex;gap:4px;align-items:center;">
                            <button class="btn btn-primary btn-xs" @onclick="() => SendCard(card)" disabled="@(_busy || card.Status == "Sending" || isSent)">@(isSent ? "✓ 已发送" : "📤 发送")</button>
                            <button class="btn btn-outline btn-xs" @onclick="() => OpenEdit(card)" disabled="@(_busy || card.Status == "Sending" || isSent)" title="编辑发送参数">✏️ 编辑</button>
                            <button class="btn btn-danger btn-xs" @onclick="() => DeleteCard(card)" @onclick:stopPropagation>✕</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            }
            @if (!string.IsNullOrEmpty(_sortingResp))
            {
                <div class="response-panel @_sortingRespClass" style="margin-top:8px;">@_sortingResp</div>
            }
            break;
        }
    }
    </div>

    @* ── 分拣信号编辑弹窗：重新输入发送参数，确认后覆盖该表格行 ── *@
    @if (_editingCard != null && _editDraft != null)
    {
        var editing = _editingCard;
        var draft = _editDraft;
        <div class="edit-overlay" @onclick:stopPropagation>
            <div class="edit-modal" @onclick:stopPropagation>
                <div class="edit-modal-header">
                    <span class="edit-modal-title">✏️ 编辑分拣信号</span>
                    <span class="hint-text" style="margin:0;">任务号 <code>@editing.TaskId</code></span>
                    <span style="flex:1;"></span>
                    <button class="btn btn-outline btn-xs" @onclick="CancelEdit">✕</button>
                </div>
                <div class="edit-modal-body">
                    <div class="form-grid2" style="margin-top:0;">
                        <div class="form-group" style="grid-column:1/-1;">
                            <label>回库任务号（留空=使用分拣任务号）</label>
                            <input type="text" @bind="draft.ReturnTaskId" placeholder="@editing.TaskId" />
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            <label class="sorting-check"><input type="checkbox" @bind="draft.RemoveContainer" />🚪 容器出场（勾选=GRCS 不再生成回库任务）</label>
                        </div>
                        <div class="form-group">
                            <label>推荐目的地</label>
                            <input type="text" @bind="draft.DestStation" placeholder="留空=回原库位" />
                        </div>
                        <div class="form-group">
                            <label>推荐区域</label>
                            <input type="text" @bind="draft.DestArea" placeholder="留空=不指定" />
                        </div>
                    </div>
                </div>
                <div class="edit-modal-footer">
                    <button class="btn btn-outline btn-sm" @onclick="CancelEdit">取消</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveEdit">确认</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Text.Json.JsonSerializerOptions _jsonOpts = new() { PropertyNameCaseInsensitive = true };

    // ── 连接 ──
    private bool _busy, _pollingOk = true;
    private string _lastError = "";

    // ── 各区域刷新/清空反馈（独立，互不干扰）──
    private string _admRefreshMsg = "", _arrivalRefreshMsg = "", _removalRefreshMsg = "", _sortingRefreshMsg = "";
    private string _admClearMsg = "", _arrivalClearMsg = "", _removalClearMsg = "", _sortingClearMsg = "";
    private System.Threading.Timer? _admRefreshTimer, _arrivalRefreshTimer, _removalRefreshTimer, _sortingRefreshTimer;
    private System.Threading.Timer? _admClearTimer, _arrivalClearTimer, _removalClearTimer, _sortingClearTimer;
    // ── 清空确认状态 ──
    private bool _admConfirming, _arrivalConfirming, _removalConfirming, _sortingConfirming;
    private void ShowFeedback(Action<string> setMsg, string text, ref System.Threading.Timer? timer)
    {
        setMsg(text);
        timer?.Dispose();
        timer = new System.Threading.Timer(_ => { setMsg(""); InvokeAsync(StateHasChanged); },
            null, TimeSpan.FromSeconds(2), Timeout.InfiniteTimeSpan);
        StateHasChanged();
    }

    // ── 进入申请 ──
    private bool _autoMode;
    private bool _autoModeSeeded; // true = localStorage 有缓存，不需要从后端同步
    private int _pendingCount;
    private List<EntryRequestEvent> _events = [];

    // ── 货物到达（自动开关/自动确认在 SignalAutoService，后台跨页面运行）──
    private List<ArrivalCard> _arrivalCards = [];
    private HashSet<string> _confirmedTasks = [];
    private HashSet<string> _deletedArrivalTasks = [];
    private bool _arrivalBusy;
    private int _pendingArrival;
    private string _cardError = "";

    // ── 货物移除 ──
    private List<RemovalCard> _removalCards = [];
    private HashSet<string> _confirmedRemovalTasks = [];
    private HashSet<string> _deletedRemovalTasks = [];
    private bool _removalBusy;
    private int _pendingRemoval;

    // ── 分拣信号（自动发送在 SignalAutoService）──
    private List<SortingCard> _cards = [];
    private int _pendingSorting => _cards.Count(c => c.Status == "Pending");
    private string _sortingResp = "";
    private string _sortingRespClass = "";

    /// <summary>
    /// 共享刷新：零 HTTP 产出到达/移除卡片和分拣卡片。
    /// 优化前这里会 GetTaskStageEventsAsync 拉一次全量；现在阶段事件与 FINISHED 集合
    /// 直接从 TaskStageHub 内存缓存读（hub 负责轮询与增量合并）。
    /// 下面两个构建方法复用同一份数据单趟遍历，仍保持"一次内存读 + 一次台账读"的
    /// 省事设计（台账走 TaskLedgerService 内存缓存，也无 HTTP）。
    /// </summary>
    private async Task RefreshAllAsync()
    {
        try
        {
            // ── 读共享 SignalR 缓存：阶段事件 + FINISHED 集合（零 HTTP，实时推送由 TaskStageHub 统一接收）──
            await StageHub.EnsureStartedAsync();
            List<StageChangeEvent> stageEvents = StageHub.Events.ToList();
            HashSet<string> finishedIds = StageHub.FinishedTaskIds;
            // 连接判定用共享后端健康状态（BackendHealthService，同 BackendStatus 绿点，AutomationHub 1s 回报）
            if (Health.WcsOnline == false) { _pollingOk = false; _lastError = "无法连接 WCS 后端"; }
            else { _pollingOk = true; _lastError = ""; }

            // ── 确认/已发送集合：后端 workflow_state（AutomationHub 1s 轮询，跨标签页一致）──
            _confirmedTasks = AutoHub.ConfirmedIds("arrival");
            _confirmedRemovalTasks = AutoHub.ConfirmedIds("removal");
            _sentTasks = AutoHub.ConfirmedIds("sent");

            // ── 只要一次 JS interop：拉下发历史，单趟遍历同时产出 dispatchedIds + 到达/移除卡片 ──
            await BuildTaskCardsAsync(finishedIds, stageEvents);

            // ── 分拣卡片复用同一次 stageEvents ──
            BuildSortingCards(stageEvents);
        }
        catch (Exception ex) { _cardError = ex.Message; }
    }

    /// <summary>从任务台账构建到达/移除卡片（唯一数据源，内存缓存读取）。ContainerCode=托盘号，CargoCode=货物号。</summary>
    private async Task BuildTaskCardsAsync(HashSet<string> finishedIds, List<StageChangeEvent> stageEvents)
    {
        try
        {
            _cardError = "";
            var entries = await Ledger.GetAsync();

            // 申请时间 = GRCS 任务完成时刻（FINISHED 事件时间）；下发时间 = 信号确认/发送落库时刻（workflow_state.time）
            var finishedTime = stageEvents.Where(e => e.Stage == "FINISHED" && !string.IsNullOrEmpty(e.TaskId))
                .GroupBy(e => e.TaskId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Last().Time, StringComparer.OrdinalIgnoreCase);
            var arrivalConfirmTime = ConfirmTimeMap("arrival");
            var removalConfirmTime = ConfirmTimeMap("removal");

            // 段2 检查用：成功下发的任务号
            var dispatchedIds = new HashSet<string>(entries.Where(e => e.Ok).Select(e => e.TaskId));

            // 构建到达卡片（入库段1 自动 / 入库段2 手动）
            var arrivals = new List<ArrivalCard>();
            foreach (var t in entries)
            {
                if (string.IsNullOrEmpty(t.TaskId)) continue;
                if (_deletedArrivalTasks.Contains(t.TaskId)) continue;
                var isAuto = t.TaskId.StartsWith("SimAuto_", StringComparison.OrdinalIgnoreCase);
                var isManual = t.TaskId.StartsWith("SimManual_", StringComparison.OrdinalIgnoreCase);
                if (!isAuto && !isManual) continue;
                if (!(isAuto && t.TaskType == "CONTAINER_CARRY_INBOUND") && !(isManual && t.TaskType == "CARGO_CARRY_INBOUND")) continue;
                if (isAuto && (!finishedIds.Contains(t.TaskId) || !dispatchedIds.Contains(Seg2Id(t.TaskId)))) continue;
                var st = isAuto ? t.StationCode.LastOrDefault() : t.StationCode.FirstOrDefault();
                // 货物码：自动模式由后端在段2 下发时写入台账（段2 条目 CargoCode），无需本地生成
                var cargoCode = isAuto
                    ? (entries.FirstOrDefault(e => e.TaskId == Seg2Id(t.TaskId))?.CargoCode ?? t.CargoCode)
                    : t.CargoCode;
                arrivals.Add(new ArrivalCard
                {
                    TaskId = t.TaskId, ConveyorCode = (st ?? "").ToWcsCode(_mapStations), ContainerCode = cargoCode,
                    Warehouse = t.Warehouse, Time = t.Time, Confirmed = _confirmedTasks.Contains(t.TaskId),
                    AppliedAt = finishedTime.TryGetValue(t.TaskId, out var ft) ? ft : null,
                    SendAt = arrivalConfirmTime.TryGetValue(t.TaskId, out var stm) ? stm : null
                });
            }
            _arrivalCards = arrivals;
            _pendingArrival = arrivals.Count(c => !c.Confirmed);

            // 构建移除卡片（出库段1 自动 / 出库段2 手动）：容器号取货物号，没有则回退托盘号
            var removals = new List<RemovalCard>();
            foreach (var t in entries)
            {
                if (string.IsNullOrEmpty(t.TaskId)) continue;
                if (_deletedRemovalTasks.Contains(t.TaskId)) continue;
                var isAuto = t.TaskId.StartsWith("SimAuto_", StringComparison.OrdinalIgnoreCase);
                var isManual = t.TaskId.StartsWith("SimManual_", StringComparison.OrdinalIgnoreCase);
                if (!isAuto && !isManual) continue;
                if (!(isAuto && t.TaskType == "CARGO_CARRY_OUTBOUND") && !(isManual && t.TaskType == "CONTAINER_CARRY_OUTBOUND")) continue;
                if (isAuto && (!finishedIds.Contains(t.TaskId) || !dispatchedIds.Contains(Seg2Id(t.TaskId)))) continue;
                var st = isAuto ? t.StationCode.LastOrDefault() : t.StationCode.FirstOrDefault();
                var containerCode = string.IsNullOrEmpty(t.CargoCode) ? t.ContainerCode : t.CargoCode;
                removals.Add(new RemovalCard
                {
                    TaskId = t.TaskId, ConveyorCode = (st ?? "").ToWcsCode(_mapStations), ContainerCode = containerCode,
                    Warehouse = t.Warehouse, Time = t.Time, Confirmed = _confirmedRemovalTasks.Contains(t.TaskId),
                    AppliedAt = finishedTime.TryGetValue(t.TaskId, out var ft) ? ft : null,
                    SendAt = removalConfirmTime.TryGetValue(t.TaskId, out var stm) ? stm : null
                });
            }
            _removalCards = removals;
            _pendingRemoval = removals.Count(c => !c.Confirmed);
        }
        catch (Exception ex) { _cardError = ex.Message; }
    }

    /// <summary>workflow_state 某 kind 的确认/发送时间（TaskId → 落库时刻）。</summary>
    private Dictionary<string, DateTime?> ConfirmTimeMap(string kind)
    {
        var map = new Dictionary<string, DateTime?>(StringComparer.OrdinalIgnoreCase);
        if (AutoHub.ConfirmState.TryGetValue(kind, out var rows))
        {
            foreach (var r in rows)
                map[r.TaskId] = DateTime.TryParse(r.Time, out var dt) ? dt : null;
        }
        return map;
    }

    /// <summary>从预加载的阶段事件中筛选分拣完成卡片（不再额外调 HTTP）。</summary>
    private void BuildSortingCards(List<StageChangeEvent> stageEvents)
    {
        try
        {
            if (_mapStations.Count == 0) return;
            var finished = stageEvents.Where(e => e.Stage == "FINISHED").OrderBy(e => e.Time);
            foreach (var e in finished)
            {
                var station = _mapStations.FirstOrDefault(s => s.Mark == e.StationCode)
                    ?? _mapStations.FirstOrDefault(s => s.Mark == e.StationCode.ToMark());
                if (station == null) continue;
                if ((station.StationType & (MapStationTypeBits.PickingStation | MapStationTypeBits.PeopleStation)) == 0) continue;
                var isSent = _sentTasks.Contains(e.TaskId);
                if (!_knownTasks.Add(e.TaskId))
                {
                    // 已有卡片：仅同步状态与发送参数（后端自动发送/其他标签页发送后及时翻转为已发送，不重建卡片）
                    var existing = _cards.FirstOrDefault(c => c.TaskId == e.TaskId);
                    if (existing != null)
                    {
                        if (isSent && AutoHub.SentParams(e.TaskId) is SortingSendParams sp2)
                        {
                            existing.ReturnTaskId = string.IsNullOrEmpty(sp2.ReturnTaskId) ? existing.ReturnTaskId : sp2.ReturnTaskId;
                            existing.RemoveContainer = sp2.RemoveContainer;
                            existing.DestStation = sp2.DestStation ?? "";
                            existing.DestArea = sp2.DestArea ?? "";
                            existing.Status = "Sent";
                        }
                        else if (existing.Status == "Pending") existing.Status = isSent ? "Sent" : "Pending";
                    }
                    continue;
                }
                var card = new SortingCard { TaskId = e.TaskId, TaskType = string.Join("+", MapStationTypeBits.DecodeNames(station.StationType)), ContainerCode = e.ContainerCode, Warehouse = e.Warehouse, PickStation = e.StationCode, FoundAt = e.Time, ReturnTaskId = e.TaskId + "_R", Status = isSent ? "Sent" : "Pending" };
                // 已发送的卡片：用后端保存的发送参数重建（含操作员编辑过的值），刷新后不走样
                if (isSent && AutoHub.SentParams(e.TaskId) is SortingSendParams sp)
                {
                    card.ReturnTaskId = string.IsNullOrEmpty(sp.ReturnTaskId) ? card.ReturnTaskId : sp.ReturnTaskId;
                    card.RemoveContainer = sp.RemoveContainer;
                    card.DestStation = sp.DestStation ?? "";
                    card.DestArea = sp.DestArea ?? "";
                    card.Status = "Sent";
                }
                _cards.Insert(0, card);
            }
        }
        catch { }
    }

    private HashSet<string> _knownTasks = [];
    private HashSet<string> _sentTasks = [];
    private List<MapStationLite> _mapStations = [];

    // ── 类型 tab：四个类型共用一片展示区，切换即切内容（选中项持久化）──
    private string _activeSection = "adm";
    private void SetSection(string k)
    {
        if (_activeSection == k) return;
        _activeSection = k;
        _ = LocalStore.SetAsync(Js, "grcs_si_tab", k);
        _ = InvokeAsync(async () => { await RefreshExpandedSections(); StateHasChanged(); });
    }

    private string _storageListenerId = "";
    private bool _storageListenerRegistered;
    private bool _refreshing;
    private System.Threading.Timer? _refreshDebounceTimer;

    protected override async Task OnInitializedAsync()
    {
        SignalAuto.Changed += OnSignalChanged; // 订阅信号自动确认服务（切到其他模块后服务继续后台运行，页面销毁时在 Dispose 退订）
        StageHub.Changed += OnHubChanged; // 订阅共享轮询器：后端有新阶段事件（含 FINISHED）即防抖重建，替代手动刷新
        AutoHub.Changed += OnHubChanged; // 进入申请/自动化状态：AutomationHub 1s 共享轮询，多标签页同步

        // 读取 localStorage 状态（内存缓存，同步读取，无 JS 边界）
        try
        {
            string? V(string k) => LocalStore[k] is { } v && v != "null" ? v : null;
            if (V("grcs_si_auto_mode") is string am) { _autoMode = am == "1"; _autoModeSeeded = true; }
            if (V("grcs_si_tab") is string tab && tab is "adm" or "arrival" or "removal" or "sorting") _activeSection = tab;
            if (V("grcs_si_del_arrival") is string da) { var l = System.Text.Json.JsonSerializer.Deserialize<List<string>>(da); if (l != null) foreach (var id in l) _deletedArrivalTasks.Add(id); }
            if (V("grcs_si_del_removal") is string dr) { var l = System.Text.Json.JsonSerializer.Deserialize<List<string>>(dr); if (l != null) foreach (var id in l) _deletedRemovalTasks.Add(id); }
            if (V("grcs_map_stations") is string mapJ) { var cache = System.Text.Json.JsonSerializer.Deserialize<MapStationCache>(mapJ); _mapStations = cache?.Stations ?? []; }
        }
        catch { }

        // 先拉起信号自动服务（LoadConfig 读自动开关），尽快进入自动状态
        await SignalAuto.EnsureStartedAsync();

        // 一次性迁移：旧 localStorage 确认集合 → 后端 workflow_state（后端空时播种后清除旧键）
        _ = MigrateLegacyAsync();

        // 以前端为主：后台把进入申请模式同步给后端（不阻塞页面初始化）
        if (_autoModeSeeded)
        {
            _ = SyncAdmittanceModeAsync();
        }

        // 懒加载：只拉展开的 section 数据，折叠的等用户展开时再拉
        await RefreshExpandedSections();

        // 订阅 storage 事件（跨标签页状态变更 → 触发 UI 刷新），替代轮询定时器
        if (!_storageListenerRegistered)
        {
            _storageListenerId = await Js.InvokeAsync<string>("grcsRegisterStorageListener", DotNetObjectReference.Create(this), "si_" + Guid.NewGuid().ToString("N"));
            _storageListenerRegistered = true;
        }
    }

    /// <summary>JS storage 事件回调，由 index.html 中的 grcsRegisterStorageListener 调用。</summary>
    [JSInvokable("OnStorageChanged")]
    public async Task OnStorageChanged(string key, string newValue)
    {
        // 存储变更（跨标签页）→ 防抖后统一刷新，避免短时间内多次 StateHasChanged
        ScheduleRefresh();
    }

    /// <summary>防抖动刷新调度：多个事件在 500ms 内触发只执行一次刷新。</summary>
    private void ScheduleRefresh()
    {
        _refreshDebounceTimer?.Dispose();
        _refreshDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshExpandedSections();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromMilliseconds(500), Timeout.InfiniteTimeSpan);
    }

    /// <summary>后台同步进入申请模式到后端（fire-and-forget，避免阻塞页面初始化；走统一信号接口）。</summary>
    private async Task SyncAdmittanceModeAsync()
    {
        try { await WcsApi.PostAsync("/api/wcs/auto/signals", new { admittanceAuto = _autoMode }); } catch { }
    }

    /// <summary>刷新页面数据。徽章/卡片为纯内存重建（0 HTTP 或缓存读取）。</summary>
    private async Task RefreshExpandedSections()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            await LoadStatus();               // 进入申请徽章：不依赖当前 tab，任何 tab 下都实时更新
            if (_activeSection == "adm") await LoadEvents();
            await RefreshAllAsync();
        }
        finally { _refreshing = false; }
    }

    private void OnSignalChanged()
    {
        // 自动确认后立即全量重建（RefreshAllAsync 已 0 HTTP、全内存）：重算待确认徽章 + 刷新行内状态。
        _ = InvokeAsync(async () =>
        {
            await RefreshAllAsync();
            StateHasChanged();
        });
    }

    /// <summary>hub 拉到新阶段事件（任务 FINISHED、新卡片可生成）→ 防抖重建，卡片/徽章自动跟上。</summary>
    private void OnHubChanged() => ScheduleRefresh();

    public void Dispose()
    {
        SignalAuto.Changed -= OnSignalChanged;
        StageHub.Changed -= OnHubChanged;
        AutoHub.Changed -= OnHubChanged;
        _refreshDebounceTimer?.Dispose();
        _refreshDebounceTimer = null;
        if (_storageListenerRegistered && !string.IsNullOrEmpty(_storageListenerId))
            try { Js.InvokeVoidAsync("grcsUnregisterStorageListener", _storageListenerId); } catch { }
        _storageListenerRegistered = false;
        _storageListenerId = "";
        _admRefreshTimer?.Dispose(); _arrivalRefreshTimer?.Dispose(); _removalRefreshTimer?.Dispose(); _sortingRefreshTimer?.Dispose();
        _admClearTimer?.Dispose(); _arrivalClearTimer?.Dispose(); _removalClearTimer?.Dispose(); _sortingClearTimer?.Dispose();
    }

    // ── 进入申请（数据来自 AutomationHub 1s 共享轮询，多标签页同步；手动操作 POST 后立即补一轮）──
    private async Task LoadStatus() { _pendingCount = AutoHub.PendingCount; _pollingOk = Health.WcsOnline != false; _lastError = Health.WcsOnline == false ? "无法连接 WCS 后端" : ""; }
    private async Task LoadEvents() { _events = AutoHub.EntryEvents.ToList(); }
    private async Task RefreshAdmittanceNow(bool showFeedback = true) { _busy = true; await AutoHub.RefreshNowAsync(); await LoadStatus(); await LoadEvents(); _busy = false; if (showFeedback) ShowFeedback(v => _admRefreshMsg = v, "✓ 刷新成功", ref _admRefreshTimer); }
    private async Task ToggleMode() { _busy = true; var newMode = !AutoHub.AdmittanceAutoMode; _autoMode = newMode; await LocalStore.SetAsync(Js, "grcs_si_auto_mode", newMode ? "1" : "0"); AutoHub.ApplyAdmittanceMode(newMode); StateHasChanged(); await WcsApi.PostAsync("/api/wcs/auto/signals", new { admittanceAuto = newMode }); _busy = false; }
    private async Task Decide(string key, bool allow) { _busy = true; await WcsService.DecideEntryAsync("", key, allow); await AutoHub.RefreshNowAsync(); await LoadEvents(); _busy = false; }
