@page "/wcs-simulator/automation"
@inject IWcsService WcsService
@inject IJSRuntime Js
@inject LocalStoreService LocalStore
@inject CargoCodeService CargoCodes
@inject StationLockService StationLocks
@inject AutoRunService Auto
@inject ContainerTaskService Container
@implements IDisposable
@using System.Text.Json
@using GRCS.Dashboard.Modules.WcsSimulator.Models

@* ════════════════════════════════════════════════
   页面职责：WCS 模拟器的「自动化任务」页，三个独立功能区块
   ① 批量移动任务下发：从地图缓存按来源（手输 / 类型+楼层）筛选候选池，
      随机生成一批 MOVE_ONLY 任务并逐条 POST 到 GRCS /api/RawOrder/ChangeFloor
   ② 自动容器任务下发：执行状态托管到单例服务 ContainerTaskService，
      两段式任务编排在服务内部完成，切换模块不中断
   ③ 自动化轮询储位：运行状态托管到单例服务 AutoRunService，
      页面仅订阅 Changed 事件刷新，日志与计数跨导航存活
   ── 交互服务 ──
   IWcsService：向 GRCS 下发车辆任务（ChangeFloor）
   ContainerTaskService / AutoRunService：跨页面存活的后台执行服务
   LocalStoreService：配置与折叠状态持久化到浏览器 localStorage
   ════════════════════════════════════════════════ *@
<PageTitle>自动化任务</PageTitle>

@* ════════════════════════════════════════════════
   连接设置：GRCS 地址与场景名称在页面初始化时从共享 localStorage 键
   （grcs_grcs_url / grcs_warehouse）恢复，修改后随表单绑定立即生效
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleConn" title="点击折叠/展开">
        🔌 连接设置
        <span class="addr-badge">GRCS @_baseUrl</span>
        <span class="collapse-arrow">@(IsCollapsed("conn") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("conn"))
    {
    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <div class="form-group" style="flex:1;min-width:140px;max-width:220px;">
            <label>GRCS 地址</label>
            <input type="text" @bind="_baseUrl" placeholder="http://localhost:8224">
        </div>
        <div class="form-group" style="flex:1;min-width:120px;max-width:180px;">
            <label>场景名称</label>
            <input type="text" @bind="_sceneName" placeholder="Show">
        </div>
    </div>
    }
</div>

@* ════════════════════════════════════════════════
   选点范围：限制自动化任务（轮询储位 + 自动容器）的选点范围。
   配置持久化到 localStorage（grcs_auto_range），两个服务加载时按此过滤候选池。
   支持 站点类型 + 楼层 + 手动 Mark 白名单（三者 AND）。
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleRange" title="点击折叠/展开">
        🎯 选点范围
        <span class="badge @(_range.Enabled ? "badge-ok" : "badge-warn")">@(_range.Enabled ? "已启用" : "未启用")</span>
        <span class="addr-badge">候选 @_rangePool.Count 个</span>
        <button class="btn btn-sm @(_range.Enabled ? "btn-danger" : "btn-primary")" @onclick="ToggleRangeEnabled" @onclick:stopPropagation>
            @(_range.Enabled ? "关闭限制" : "开启限制")
        </button>
        <span class="collapse-arrow">@(IsCollapsed("range") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("range"))
    {
    <div class="hint-text" style="margin-bottom:8px;">开启后，「自动化」与「自动容器任务下发」只在下述范围内随机选点（接驳位/储位/分拣台）。</div>

    <div class="form-group">
        <label>站点类型（可多选，不选=不限类型）</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            @foreach (var (bit, name) in MapStationTypeBits.All)
            {
                <button class="chip-btn @((_range.TypeFilter & bit) != 0 ? "on" : "")" @onclick="() => ToggleRangeType(bit)">@name</button>
            }
        </div>
    </div>

    <div class="form-group" style="margin-top:6px;">
        <label>楼层</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button class="chip-btn @(_range.FloorFilter == 0 ? "on" : "")" @onclick="() => { _range.FloorFilter = 0; SaveRange(); }">全部</button>
            @foreach (var f in _rangeAvailableFloors)
            {
                <button class="chip-btn @(_range.FloorFilter == f ? "on" : "")" @onclick="() => { _range.FloorFilter = f; SaveRange(); }">@f 层</button>
            }
        </div>
    </div>

    <div class="form-group" style="margin-top:6px;">
        <label>手动指定站点编码（可多个，逗号/空格/换行分隔；与类型/楼层取交集）</label>
        <textarea @bind="_rangeMarksText" @bind:event="oninput" rows="2" placeholder="留空=不限，如：0100001427, 0100001837"></textarea>
    </div>

    <div class="hint-text" style="margin-top:4px;">
        @if (_range.Enabled)
        {
            <text>当前限制候选 @_rangePool.Count 个站点：@(string.Join(", ", _rangePool.Take(5).Select(s => s.Mark)))…</text>
        }
        else
        {
            <text>未启用，自动化任务从全地图随机选点。</text>
        }
    </div>
    }
</div>

@* ════════════════════════════════════════════════
   批量移动任务下发
   ── 流程 ── 确定站点来源（手输 / 按类型+楼层筛选）→ 计算候选池
   （_batchPool）→ 随机生成任务预览 → SendBatch 逐条 POST
   GRCS /api/RawOrder/ChangeFloor，按 _batchInterval 秒节流
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleBatch" title="点击折叠/展开">
        📦 批量移动任务下发
        <span class="badge-info">统一自动分配车辆</span>
        <span class="collapse-arrow">@(IsCollapsed("batch") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("batch"))
    {

    @* 站点来源模式 *@
    <div style="height:200px;overflow:visible;">
    <div class="form-group">
        <label>站点来源</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button class="chip-btn @(_batchSource == "manual" ? "on" : "")" @onclick="SetBatchSourceManual">✍️ 手输站点</button>
            <button class="chip-btn @(_batchSource == "type" ? "on" : "")" @onclick="SetBatchSourceType">🏷️ 按类型选择</button>
        </div>
    </div>

    @if (_batchSource == "manual")
    {
        <div class="form-group">
            <label>站点编码（多个用 逗号/空格/换行 分隔）</label>
            <textarea @bind="_batchManualSites" @bind:event="oninput" rows="2" placeholder="0100001427, 0100001837&#10;0100001806"></textarea>
            <div class="hint-text" style="margin-top:4px;">
                已识别 @_manualSites.Count 个站点
                @if (_mapStations.Count > 0) { <text>· 其中 @(_batchPool.Count) 个存在于地图数据</text> }
            </div>
        </div>
    }
    else
    {
        <div class="form-group">
            <label>选择站点类型（可多选）</label>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                @foreach (var (bit, name) in MapStationTypeBits.All)
                {
                    <button class="chip-btn @((_batchTypeFilter & bit) != 0 ? "on" : "")" @onclick="() => ToggleBatchType(bit)">@name</button>
                }
            </div>
        </div>
        <div class="form-group" style="margin-top:6px;">
            <label>选择层数</label>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                <button class="chip-btn @(_batchFloorFilter == 0 ? "on" : "")" @onclick="() => _batchFloorFilter = 0">全部</button>
                @foreach (var f in _availableFloors)
                {
                    <button class="chip-btn @(_batchFloorFilter == f ? "on" : "")" @onclick="() => _batchFloorFilter = f">@f 层</button>
                }
            </div>
        </div>
        <div class="hint-text" style="margin-top:4px;">
            @if (_batchPool.Count > 0)
            {
                <text>候选池 @_batchPool.Count 个：@string.Join(", ", _batchPool.Take(3).Select(s => s.Mark)) …</text>
            }
            else if (_batchTypeFilter != 0)
            {
                <text>不存在当前类型站点</text>
            }
            else
            {
                <text>请先选择类型和层数</text>
            }
        </div>
    }
    </div>

    <div style="border-top:1px solid #334155;margin:14px 0 4px;"></div>

    @* 执行次数 + 优先级 + 名称前缀 *@
    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-top:10px;">
        <div class="form-group" style="flex:1;min-width:100px;max-width:140px;">
            <label>执行次数</label>
            <input type="number" @bind="_batchCount" min="1" max="500" />
        </div>
        <div class="form-group" style="flex:1;min-width:90px;max-width:120px;">
            <label>下发间隔(秒)</label>
            <input type="number" @bind="_batchInterval" min="0" max="60" step="1">
        </div>
        <div class="form-group" style="flex:1;min-width:150px;max-width:250px;">
            <label>优先级 (0-1000)</label>
            <div style="display:flex;align-items:center;gap:10px;">
                <input type="range" min="0" max="1000" step="10" @bind="_batchPriority" style="flex:1;">
                <span style="font-weight:700;color:#38bdf8;min-width:36px;text-align:center;">@_batchPriority</span>
            </div>
        </div>
        <div class="form-group" style="flex:1;min-width:160px;max-width:260px;">
            <label>OrderId 前缀</label>
            <input type="text" @bind="_batchOrderIdPrefix" placeholder="Simulate_MoveOnly_">
        </div>
    </div>

    <div style="display:flex;gap:10px;margin-top:10px;flex-wrap:wrap;">
        <button class="btn btn-primary" @onclick="GenerateBatch" disabled="@_batchSending">🎲 随机生成 @_batchCount 个任务</button>
        <button class="btn btn-outline" @onclick="ClearBatch">🧹 清空</button>
    </div>

    @if (_generatedTasks.Count > 0)
    {
        <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;">
            <span class="badge-info">候选池 @_batchPool.Count 个 → 已生成 @_generatedTasks.Count 个任务</span>
            <button class="btn btn-outline btn-sm" @onclick="GenerateBatch">🔄 重新生成</button>
        </div>

        @* 生成的任务预览 *@
        <div style="max-height:200px;overflow-y:auto;margin-top:8px;border:1px solid #334155;border-radius:8px;background:#0b1220;">
            @foreach (var t in _generatedTasks)
            {
                <div style="display:flex;justify-content:space-between;gap:10px;padding:5px 10px;border-bottom:1px solid #1e293b;font-size:0.75rem;">
                    <span style="color:#64748b;">#@t.No</span>
                    <span style="font-family:Consolas,monospace;color:#e2e8f0;">@t.Mark</span>
                    <span style="color:#94a3b8;">@TypeLabel(t.StationType)</span>
                </div>
            }
        </div>

        <div style="margin-top:10px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <button class="btn btn-primary" @onclick="SendBatch" disabled="@_batchSending">
                @(_batchSending ? $"⏳ 下发中 {_batchSent}/{_batchTotal} ..." : "🚀 批量下发")
            </button>
            <span class="hint-text" style="margin:0;">逐条调用 ChangeFloor 接口下发</span>
        </div>
    }
    }
</div>

@* ════════════════════════════════════════════════
   自动容器任务下发（状态托管到 ContainerTaskService，切模块不中断）
   ── 说明 ── 两段式自动任务（入库段1+段2 / 出库段1+段2 / 分拣）由
   ContainerTaskService 按场景编排下发；库存缓存与执行日志保存在服务内，
   本页通过 Container.Changed 事件订阅刷新，切走再回来仍然可见
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleContainer" title="点击折叠/展开">
        📦 自动容器任务下发
        <span class="badge-info">两段式自动任务 · 跨模块执行</span>
        <span class="collapse-arrow">@(IsCollapsed("container") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("container"))
    {

    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <div class="form-group" style="flex:1;min-width:100px;max-width:140px;">
            <label>任务数量</label>
            <input type="number" @bind="_containerCount" min="1" max="100" />
        </div>
        <div class="form-group" style="flex:1;min-width:120px;max-width:180px;">
            <label>下发间隔(秒)</label>
            <input type="number" @bind="_containerInterval" min="0" max="30" step="1">
        </div>
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
        <button class="btn @(_containerFlow == 1 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 1'>
            📥 空托盘入库
        </button>
        <button class="btn @(_containerFlow == 2 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 2'>
            📤 带货托盘出库
        </button>
        <button class="btn @(_containerFlow == 3 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 3'>
            🔀 带货托盘分拣
        </button>
    </div>

    @if (ContainerRangeWarnings.Count > 0)
    {
        <div class="range-warning">
            ⚠ @string.Join("；", ContainerRangeWarnings)
            @if (_range.Enabled) { <text>请在「选点范围」中补充对应站点类型。</text> }
        </div>
    }

    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <button class="btn btn-outline btn-sm" @onclick="RefreshContainerInventory" disabled="@Container.Busy">📋 查询库存</button>
        <button class="btn btn-primary" @onclick="ExecuteContainerAuto" disabled="@Container.Busy">
            @(Container.Busy ? $"⏳ 执行中 {Container.Done}/{Container.Total} ..." : "🚀 执行")
        </button>
    </div>

    @* 库存缓存（查询后显示，切换模块再回来仍然可见） *@
    @if (Container.EmptyPallets > 0 || Container.LoadedPallets > 0 || Container.Cargos > 0)
    {
        <div class="hint-text" style="margin-top:6px;">
            库存缓存：空托 @Container.EmptyPallets / 带货托 @Container.LoadedPallets / 货物 @Container.Cargos / 配对货 @Container.PairedCargos
        </div>
    }

    @* 执行日志（切模块回来仍然可见） *@
    @if (Container.Logs.Count > 0)
    {
        <div style="border-top:1px solid #334155;margin:14px 0 4px;"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <span class="badge-info" style="margin-bottom:6px;">执行日志</span>
            <button class="btn btn-outline btn-sm" @onclick="ClearContainerLogs" disabled="@Container.Busy" style="margin-bottom:6px;">🧹 清空日志</button>
        </div>
        <div style="max-height:260px;overflow-y:auto;font-size:12px;line-height:1.7;font-family:Consolas,monospace;background:#0b1220;border:1px solid #1e293b;border-radius:8px;padding:8px 12px;">
            @foreach (var log in Container.Logs)
            {
                <div style="color:@log.Color;">@log.Time @log.Message</div>
            }
        </div>
    }

    }
</div>

@* ════════════════════════════════════════════════
   自动化（轮询储位自动下发）
   ── 说明 ── AutoRunService 按 Interval 秒轮询储位：发现空托 → 下发入库，
   带货托按 FlowMode（出库/分拣交替、只分拣、只出库）下发；
   任务完成后自动解除占用，下轮可再次发现。运行状态与日志在服务内，
   页面通过 Auto.Changed 事件订阅刷新
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleAutoSection" title="点击折叠/展开">
        🤖 自动化
        <span class="badge-info">轮询储位 · 自动下发</span>
        <span class="collapse-arrow">@(IsCollapsed("auto") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("auto"))
    {
    <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <div class="form-group" style="flex:1;min-width:120px;max-width:180px;">
            <label>轮询间隔(秒)</label>
            <input type="number" @bind="Auto.Interval" min="1" max="60" step="1" />
        </div>
        <div class="hint-text" style="padding-bottom:6px;">
            发现空托 → 入库；任务完成后自动解除占用，下轮可再次发现
        </div>
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;">
        <span class="hint-text" style="padding-bottom:4px;align-self:center;">带货托任务：</span>
        <button class="btn btn-sm @(Auto.FlowMode == 0 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 0'>🔀 出库/分拣交替</button>
        <button class="btn btn-sm @(Auto.FlowMode == 1 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 1'>🔀 只分拣</button>
        <button class="btn btn-sm @(Auto.FlowMode == 2 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 2'>📤 只出库</button>
    </div>

    @if (AutoRangeWarnings.Count > 0)
    {
        <div class="range-warning">
            ⚠ @string.Join("；", AutoRangeWarnings)
            @if (_range.Enabled) { <text>请在「选点范围」中补充对应站点类型。</text> }
        </div>
    }

    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px;">
        <button class="btn @(Auto.Running ? "btn-danger" : "btn-primary")" @onclick="ToggleAuto">
            @(Auto.Running ? "⏹ 停止" : "▶ 启动")
        </button>
        <button class="btn btn-outline btn-sm" @onclick="ClearAutoLogs" disabled="@Auto.Running">🧹 清空日志</button>
        @if (Auto.Running)
        {
            <span class="hint-text">⏳ 轮询中... 已下发 @Auto.Dispatched 个任务</span>
        }
    </div>

    <div style="border-top:1px solid #334155;margin:14px 0 4px;"></div>
    <div style="max-height:360px;overflow-y:auto;font-size:12px;line-height:1.7;font-family:Consolas,monospace;">
        @foreach (var log in Auto.Logs)
        {
            <div style="color:@log.Color;">@log.Time @log.Message</div>
        }
        @if (Auto.Logs.Count == 0)
        {
            <div class="hint-text">暂无日志，点击「启动」开始轮询储位</div>
        }
    </div>
    }
</div>

@* ════════════════════════════════════════════════
   响应结果：显示最近一次 HTTP 交互的结果与响应 JSON（ShowResp 写入，不持久化）
   ════════════════════════════════════════════════ *@
@if (!string.IsNullOrEmpty(_responseText))
{
    <div class="section-card">
        <div class="response-panel @_respClass">@_responseText</div>
    </div>
}

@code {
    // ── 连接设置 ──
    private string _baseUrl = "http://localhost:8224";    // GRCS 地址（车辆任务下发目标）
    private string _wcsBaseUrl = "http://localhost:8230"; // WCS 后端：task-stages 阶段事件源（与信号交互页一致）
    private string _sceneName = "";                       // 场景名称（共享键 grcs_warehouse）

    // ── 地图站点缓存（从「地图信息」页写入的 localStorage 键 grcs_map_stations 恢复，
    //    供按类型筛选候选池与手输站点校验使用）──
    private List<MapStationLite> _mapStations = [];

    // ── 批量参数（GenerateBatch 生成预览列表 _generatedTasks，SendBatch 逐条下发）──
    private string _batchSource = "manual";
    private string _batchManualSites = "";
    private int _batchTypeFilter;
    private int _batchFloorFilter;
    private int _batchCount = 5;
    private int _batchPriority = 50;
    private string _batchOrderIdPrefix = "Simulate_MoveOnly_";
    private int _batchInterval = 3;
    private List<BatchTaskItem> _generatedTasks = [];
    private bool _batchSending;
    private int _batchSent;
    private int _batchTotal;

    // ── 响应 ──
    private string _responseText = "";
    private string _respClass = "";

    // 批量任务预览行：序号 / 站点编码 / 站点类型位掩码（仅预览用，下发时重新组装请求体）
    private record BatchTaskItem(int No, string Mark, int StationType);

    // ── 卡片折叠状态（持久化到 localStorage 键 grcs_auto_collapsed）──
    private Dictionary<string, bool> _collapsed = new() { ["conn"] = true, ["range"] = true, ["batch"] = true, ["container"] = true, ["auto"] = true };
    private bool IsCollapsed(string key) => _collapsed.GetValueOrDefault(key, true);
    private async Task Toggle(string key)
    {
        _collapsed[key] = !IsCollapsed(key);
        await LocalStore.SetAsync(Js, "grcs_auto_collapsed", JsonSerializer.Serialize(_collapsed));
    }
    private Task ToggleConn() => Toggle("conn");
    private Task ToggleRange() => Toggle("range");
    private Task ToggleBatch() => Toggle("batch");
    private Task ToggleContainer() => Toggle("container");
    private Task ToggleAutoSection() => Toggle("auto");

    // ── 选点范围（grcs_auto_range：AutomationTasks / AutoRunService / ContainerTaskService 共享）──
    private AutoRangeConfig _range = new();
    private string _rangeMarksText = "";
    /// <summary>范围过滤后的候选池（实时预览用）。</summary>
    private List<MapStationLite> _rangePool => _range.ApplyTo(_mapStations);
    /// <summary>可选楼层：启用站点中符合当前类型过滤的楼层去重排序。</summary>
    private List<int> _rangeAvailableFloors => _mapStations
        .Where(s => s.StaEnable && (_range.TypeFilter == 0 || (s.StationType & _range.TypeFilter) != 0))
        .Select(s => s.Floor).Distinct().OrderBy(f => f).ToList();

    // ── 范围内的各类候选站点（与服务 ApplyRange 同口径：StaEnable + 类型位 + 范围过滤）──
    private List<MapStationLite> _rangeStorages => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.StorageLocation) != 0));
    private List<MapStationLite> _rangeTransferPoints => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.TransferPoint) != 0));
    private List<MapStationLite> _rangePickingStations => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.PeopleStation) != 0));

    /// <summary>自动容器任务按当前流程缺的必需站点类型（空 = 可正常下发）。</summary>
    private List<string> ContainerRangeWarnings
    {
        get
        {
            var w = new List<string>();
            if (_containerFlow == 1 || _containerFlow == 2)
            {
                if (_rangeTransferPoints.Count == 0) w.Add("选点范围内没有接驳位，入库/出库任务无法下发");
                if (_rangeStorages.Count == 0) w.Add("选点范围内没有储位，无法确定目标货位");
            }
            else if (_containerFlow == 3)
            {
                if (_rangePickingStations.Count == 0) w.Add("选点范围内没有分拣台，分拣任务无法下发");
            }
            return w;
        }
    }

    /// <summary>自动化（轮询储位）按当前 FlowMode 缺的必需站点类型（空 = 可正常下发）。</summary>
    private List<string> AutoRangeWarnings
    {
        get
        {
            var w = new List<string>();
            if (_rangeTransferPoints.Count == 0) w.Add("选点范围内没有接驳位，空托入库/带货出库无法下发");
            if (_rangeStorages.Count == 0) w.Add("选点范围内没有储位，无法确定目标货位");
            if (Auto.FlowMode != 2 && _rangePickingStations.Count == 0) w.Add("选点范围内没有分拣台，分拣流程无法下发");
            return w;
        }
    }

    private void ToggleRangeEnabled() { _range.Enabled = !_range.Enabled; SaveRange(); }
    private void ToggleRangeType(int bit) { _range.TypeFilter ^= bit; SaveRange(); }
    private void SaveRange()
    {
        _range.Marks = AutoRangeConfig.ParseMarks(_rangeMarksText);
        _ = LocalStore.SetAsync(Js, "grcs_auto_range", JsonSerializer.Serialize(_range));
    }

    // ── 自动化（运行状态/日志在 AutoRunService 单例中，跨导航存活；页面只订阅刷新。
    //    服务内部定时器自己管理生命周期，页面销毁时退订 Changed 事件即可）──
    private void OnAutoChanged() => InvokeAsync(StateHasChanged);
    private void OnContainerChanged() => InvokeAsync(StateHasChanged);
    /// <summary>退订两个后台服务的状态变化事件，避免组件销毁后回调泄漏。</summary>
    public void Dispose() { Auto.Changed -= OnAutoChanged; Container.Changed -= OnContainerChanged; }
    private Task ToggleAuto() => Auto.ToggleAsync();
    private void ClearAutoLogs() => Auto.ClearLogs();

    // ── 自动容器任务（用户输入参数；执行状态托管到 ContainerTaskService）──
    private int _containerFlow = 1;
    private int _containerCount = 3;
    private int _containerInterval = 3;

    /// <summary>查询 GRCS 库存并缓存到 ContainerTaskService（空托/带货托/货物/配对货计数）。</summary>
    private async Task RefreshContainerInventory()
    {
        await Container.RefreshInventoryAsync();
    }

    private void ClearContainerLogs() => Container.ClearLogs();

    /// <summary>触发 ContainerTaskService 按所选流程执行两段式容器任务，结果回显到响应面板。</summary>
    private async Task ExecuteContainerAuto()
    {
        var result = await Container.ExecuteAsync(_containerFlow, _containerCount, _containerInterval);
        ShowResp(result, result.StartsWith("✅") ? "success" : "error");
    }


    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        // 订阅两个后台服务的状态变化事件：服务状态在单例内变化时通知本页重绘，
        // 页面销毁时在 Dispose 退订，防止泄漏
        Auto.Changed += OnAutoChanged;     // 订阅自动化状态变化（页面销毁时在 Dispose 退订）
        Container.Changed += OnContainerChanged; // 订阅容器任务状态变化
        // 读取共享配置（内存缓存，同步读取）
        try
        {
            var wh = LocalStore["grcs_warehouse"];
            if (!string.IsNullOrEmpty(wh) && wh != "null") _sceneName = wh;
            var grcs = LocalStore["grcs_grcs_url"];
            if (!string.IsNullOrEmpty(grcs) && grcs != "null") _baseUrl = grcs;
            var wcs = LocalStore["grcs_wcs_url"];
            if (!string.IsNullOrEmpty(wcs) && wcs != "null") _wcsBaseUrl = wcs;
        }
        catch { }

        try
        {
            var json = LocalStore["grcs_map_stations"];
            if (!string.IsNullOrEmpty(json) && json != "null")
            {
                var cache = JsonSerializer.Deserialize<MapStationCache>(json, JsonOpts);
                _mapStations = cache?.Stations ?? [];
            }
        }
        catch { }

        try
        {
            var cjson = LocalStore["grcs_auto_collapsed"];
            if (!string.IsNullOrEmpty(cjson) && cjson != "null")
                _collapsed = JsonSerializer.Deserialize<Dictionary<string, bool>>(cjson) ?? _collapsed;
        }
        catch { }

        // 选点范围配置恢复（类型/楼层/Mark 白名单）
        try
        {
            var rjson = LocalStore["grcs_auto_range"];
            if (!string.IsNullOrEmpty(rjson) && rjson != "null")
            {
                _range = JsonSerializer.Deserialize<AutoRangeConfig>(rjson, JsonOpts) ?? new AutoRangeConfig();
                _rangeMarksText = string.Join(", ", _range.Marks);
            }
        }
        catch { }
    }

    // 手输站点文本解析：支持中英文逗号/分号/空白/换行分隔，去重保留顺序
    private List<string> _manualSites => _batchManualSites
        .Split([',', '，', ';', '；', ' ', '\t', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Distinct().ToList();

    /// <summary>
    /// 批量下发候选池：按来源模式计算
    /// - 手输：文本解析出的站点，若已加载地图数据则用地图站点（大小写不敏感匹配）
    /// - 按类型：启用站点中 StationType 位掩码包含全部所选类型位者
    /// 最后统一按楼层过滤（0=全部楼层）
    /// </summary>
    private List<MapStationLite> _batchPool
    {
        get
        {
            IEnumerable<MapStationLite> stations;
            if (_batchSource == "type")
            {
                stations = _batchTypeFilter == 0
                    ? _mapStations.Where(s => s.StaEnable)
                    : _mapStations.Where(s => s.StaEnable && (s.StationType & _batchTypeFilter) == _batchTypeFilter);
            }
            else if (_mapStations.Count == 0)
            {
                stations = _manualSites.Select(m => new MapStationLite { Mark = m });
            }
            else
            {
                stations = _manualSites
                    .Select(m => _mapStations.FirstOrDefault(s => s.Mark.Equals(m, StringComparison.OrdinalIgnoreCase)))
                    .Where(s => s != null).Select(s => s!);
            }
            if (_batchFloorFilter != 0)
                stations = stations.Where(s => s.Floor == _batchFloorFilter);
            return stations.ToList();
        }
    }

    // 切换站点来源/类型位：切换后清空已生成的预览，强制重新生成
    private void SetBatchSourceManual() { _batchSource = "manual"; _batchFloorFilter = 0; _generatedTasks.Clear(); }
    private void SetBatchSourceType() { _batchSource = "type"; _batchFloorFilter = 0; _batchTypeFilter = 0; _generatedTasks.Clear(); }
    private void ToggleBatchType(int bit) { _batchTypeFilter ^= bit; _generatedTasks.Clear(); }
    // 可选楼层列表：启用且符合当前类型筛选的站点所在楼层去重排序
    private List<int> _availableFloors => _mapStations
        .Where(s => s.StaEnable && (_batchTypeFilter == 0 || (s.StationType & _batchTypeFilter) == _batchTypeFilter))
        .Select(s => s.Floor).Distinct().OrderBy(f => f).ToList();
    private void ClearBatch() => _generatedTasks.Clear();

    /// <summary>从候选池随机抽取 _batchCount 个站点生成任务预览（尚未下发，可反复重新生成）。</summary>
    private void GenerateBatch()
    {
        var pool = _batchPool;
        if (pool.Count == 0) { ShowResp("❌ 候选站点池为空", "error"); return; }
        int n = Math.Clamp(_batchCount, 1, 500);
        var rand = Random.Shared;
        _generatedTasks = Enumerable.Range(1, n)
            .Select(i => { var st = pool[rand.Next(pool.Count)]; return new BatchTaskItem(i, st.Mark, st.StationType); })
            .ToList();
    }

    /// <summary>
    /// 批量下发流程：同一批次共用 batchId 后缀拼接 OrderId（便于整批识别），
    /// 逐条 POST GRCS /api/RawOrder/ChangeFloor（经 WcsService.SendVehicleOrderAsync），
    /// 每条之间按 _batchInterval 秒节流，进度经 _batchSent/_batchTotal 回显，
    /// 失败只记录前 5 条明细。
    /// </summary>
    private async Task SendBatch()
    {
        if (_generatedTasks.Count == 0) { ShowResp("❌ 请先随机生成任务", "error"); return; }
        if (string.IsNullOrEmpty(_sceneName)) { ShowResp("❌ 请填写场景名称", "error"); return; }

        _batchSending = true;
        _batchTotal = _generatedTasks.Count;
        _batchSent = 0;
        StateHasChanged();

        int okCount = 0;
        var errors = new List<string>();
        // 批次 ID：同一批任务的 OrderId 共用此后缀，历史里可按前缀整批识别
        var batchId = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString("x").ToUpper();

        foreach (var t in _generatedTasks)
        {
            var payload = new VehicleOrderRequest
            {
                CreateTime = DateTime.Now,
                SceneName = _sceneName,
                OrderType = "MOVE_ONLY",
                OrderId = $"{_batchOrderIdPrefix}{batchId}_{t.No}",
                OrderName = "wcs模拟器纯移动任务",
                VehicleName = null,
                Priority = _batchPriority,
                StationCodes = [t.Mark],
            };

            var (ok, code, json) = await WcsService.SendVehicleOrderAsync(_baseUrl, payload);
            if (ok) okCount++;
            else if (errors.Count < 5) errors.Add($"#{t.No} {t.Mark}: HTTP {code}");

            _batchSent++;
            StateHasChanged();

            if (_batchInterval > 0 && _batchSent < _batchTotal)
                await Task.Delay(_batchInterval * 1000);
        }

        ShowResp(
            (okCount == _batchTotal ? "✅" : "⚠️") + $" 批量下发完成：成功 {okCount}/{_batchTotal}"
            + (errors.Count > 0 ? "\n\n失败明细（前5条）：\n" + string.Join("\n", errors) : ""),
            okCount == _batchTotal ? "success" : "error");
        _batchSending = false;
    }

    /// <summary>站点类型位掩码 → 中文类型名（多类型用 + 连接；0=手输站点无类型）。</summary>
    private static string TypeLabel(int t) => t == 0 ? "手输" : string.Join("+", MapStationTypeBits.DecodeNames(t));

    /// <summary>把最近一次 HTTP 交互结果写入响应面板。</summary>
    private void ShowResp(string msg, string cls) { _responseText = msg; _respClass = cls; }
}
