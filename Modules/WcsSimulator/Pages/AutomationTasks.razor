@page "/wcs-simulator/automation"
@inject IJSRuntime Js
@inject LocalStoreService LocalStore
@inject WcsApiClient WcsApi
@inject AutomationHub Hub
@inject AutoRunService Auto
@inject ContainerTaskService Container
@implements IDisposable
@using System.Text.Json
@using GRCS.Dashboard.Modules.WcsSimulator.Models

@* ════════════════════════════════════════════════
   页面职责：WCS 模拟器的「自动化任务」页，三个独立功能区块
   ① 批量移动任务下发：从地图缓存按来源（手输 / 类型+楼层）筛选候选池，
      随机生成一批 MOVE_ONLY 任务并逐条经 WCS 后端 /api/wcs/auto/move/dispatch
      转投 GRCS /api/RawOrder/ChangeFloor（前端不再直连 GRCS）
   ② 自动容器任务下发：执行状态托管到单例服务 ContainerTaskService，
      两段式任务编排在服务内部完成，切换模块不中断
   ③ 自动化轮询储位：运行状态托管到单例服务 AutoRunService，
      页面仅订阅 Changed 事件刷新，日志与计数跨导航存活
   ── 交互服务 ──
   WcsApiClient：GrcsBackend 管理面 API（含移动任务下发中转）
   ContainerTaskService / AutoRunService：跨页面存活的后台执行服务
   LocalStoreService：配置与折叠状态持久化到浏览器 localStorage
   ════════════════════════════════════════════════ *@
<PageTitle>自动化任务</PageTitle>

@* ════════════════════════════════════════════════
   提示：GRCS 地址/场景名在「地图信息」页系统设置配置（后端单一数据源），
   本页自动读取（Hub.Status.Settings），无需连接设置
   ════════════════════════════════════════════════ *@
<div class="hint-text" style="margin:0 0 12px;">
    GRCS 地址与场景名在「地图信息」页系统设置配置，本页自动读取；自动化任务由后端执行。
</div>

@* ════════════════════════════════════════════════
    选点范围：限制自动化任务（轮询储位 + 自动容器）的选点范围。
    配置持久化到后端（/api/wcs/auto/range），两个服务加载时按此过滤候选池。
    支持 站点类型 + 楼层 + 手动 Mark 白名单（三者 AND）。
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleRange" title="点击折叠/展开">
        🎯 选点范围
        <span class="badge @(_range.Enabled ? "badge-ok" : "badge-warn")">@(_range.Enabled ? "已启用" : "未启用")</span>
        <span class="addr-badge">候选 @_rangePool.Count 个</span>
        <button class="btn btn-sm @(_range.Enabled ? "btn-danger" : "btn-primary")" @onclick="ToggleRangeEnabled" @onclick:stopPropagation>
            @(_range.Enabled ? "关闭限制" : "开启限制")
        </button>
        <span class="collapse-arrow">@(IsCollapsed("range") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("range"))
    {
    <div class="hint-text" style="margin-bottom:8px;">开启后，「自动化」与「自动容器任务下发」只在下述范围内随机选点（接驳位/储位/分拣台）。</div>

    <div class="form-group">
        <label>站点类型（可多选，不选=不限类型）</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            @foreach (var (bit, name) in MapStationTypeBits.All)
            {
                <button class="chip-btn @((_range.TypeFilter & bit) != 0 ? "on" : "")" @onclick="() => ToggleRangeType(bit)">@name</button>
            }
        </div>
    </div>

    <div class="form-group" style="margin-top:6px;">
        <label>楼层</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button class="chip-btn @(_range.FloorFilter == 0 ? "on" : "")" @onclick="() => { _range.FloorFilter = 0; SaveRange(); }">全部</button>
            @foreach (var f in _rangeAvailableFloors)
            {
                <button class="chip-btn @(_range.FloorFilter == f ? "on" : "")" @onclick="() => { _range.FloorFilter = f; SaveRange(); }">@f 层</button>
            }
        </div>
    </div>

    <div class="form-group" style="margin-top:6px;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
            <label style="margin:0;">手动指定站点编码（可多个，逗号/空格/换行分隔；与类型/楼层取交集）</label>
            <div style="display:flex;gap:6px;align-items:center;">
                <button class="btn btn-outline btn-sm" @onclick="ClearRangeMarks" title="清空手动指定的站点">🧹 清空</button>
                <button class="btn btn-outline btn-sm" @onclick="OpenStationMapPicker"
                        disabled="@(_mapStations.Count == 0)"
                        title="@(_mapStations.Count == 0 ? "需先在地图信息页加载地图数据" : "按 XY 坐标散点图框选站点，确定后写回本输入框")">
                    🗺️ 地图框选
                </button>
            </div>
        </div>
        <textarea @bind="_rangeMarksText" @bind:event="oninput" rows="2" placeholder="留空=不限，如：0100001427, 0100001837"></textarea>
    </div>

    <div class="hint-text" style="margin-top:4px;">
        @if (_range.Enabled)
        {
            <text>当前限制候选 @_rangePool.Count 个站点：@(string.Join(", ", _rangePool.Take(5).Select(s => s.Mark)))…</text>
        }
        else
        {
            <text>未启用，自动化任务从全地图随机选点。</text>
        }
    </div>
    }
</div>

@* ════════════════════════════════════════════════
   自动化（轮询储位 / 批量任务 / 纯移动任务，单卡片三模式）
   ── 说明 ── 本质是同一套两段式容器任务（入库/出库/分拣）的两种触发方式：
   轮询发现（AutoRunService，按 Interval 秒轮询储位）+ 一次性批量（ContainerTaskService），
   外加批量纯移动任务（MOVE_ONLY，候选池 = 选点范围，逐条 POST ChangeFloor）。
   运行状态与日志在各自服务内，页面通过 Auto/Container.Changed 事件订阅刷新，切走再回来仍然可见。
   轮询与批量互斥启动（防并发撞库存）；纯移动任务候选池受「选点范围」约束。
   ════════════════════════════════════════════════ *@
<div class="section-card">
    <div class="section-header collapsible" @onclick="ToggleAutoSection" title="点击折叠/展开">
        🤖 自动化 · 轮询储位 / 批量任务 / 纯移动
        <span class="badge-info">两段式容器 + MOVE_ONLY</span>
        <span class="collapse-arrow">@(IsCollapsed("auto") ? "▸ 展开" : "▾ 收起")</span>
    </div>
    @if (!IsCollapsed("auto"))
    {
    @if (_range.Enabled)
    {
        <div class="range-banner">🎯 范围选点已开启，仅在限制范围内自动化下发任务（候选 @_rangePool.Count 个站点：储位 @_rangeStorages.Count / 接驳位 @_rangeTransferPoints.Count / 分拣台 @_rangePickingStations.Count）</div>
    }

    @if (OtherTabActive)
    {
        <div class="range-warning">⚠ 另一标签页正在下发任务（@OtherTabDesc），本页已禁止下发操作，避免并发撞车。</div>
    }

    @* 模式切换：轮询自动化 / 批量任务 / 纯移动任务 *@
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;">
        <button class="chip-btn @(_autoMode == "poll" ? "on" : "")" @onclick='() => _autoMode = "poll"'>🔄 轮询自动化</button>
        <button class="chip-btn @(_autoMode == "batch" ? "on" : "")" @onclick='() => _autoMode = "batch"'>📦 批量任务</button>
        <button class="chip-btn @(_autoMode == "move" ? "on" : "")" @onclick='() => _autoMode = "move"'>🚚 纯移动任务</button>
    </div>

    @* 模式内容区：固定最小高度，切换模式时下方分割线/日志区不跳动 *@
    <div style="min-height:200px;">
    @if (_autoMode == "poll")
    {
        @* ── 轮询模式（AutoRunService）── *@
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
            <div class="form-group" style="flex:1;min-width:120px;max-width:180px;">
                <label>轮询间隔(秒)</label>
                <input type="number" @bind="Auto.Interval" min="1" max="60" step="1" />
            </div>
            <div class="hint-text" style="padding-bottom:6px;">
                发现空托 → 入库；任务完成后自动解除占用，下轮可再次发现
            </div>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;">
            <span class="hint-text" style="padding-bottom:4px;align-self:center;">带货托任务：</span>
            <button class="btn btn-sm @(Auto.FlowMode == 0 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 0'>🔀 出库/分拣交替</button>
            <button class="btn btn-sm @(Auto.FlowMode == 1 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 1'>🔀 只分拣</button>
            <button class="btn btn-sm @(Auto.FlowMode == 2 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 2'>📤 只出库</button>
            <button class="btn btn-sm @(Auto.FlowMode == 3 ? "btn-primary" : "btn-outline")" @onclick='() => Auto.FlowMode = 3'>🚫 无任务</button>
        </div>

        @if (AutoRangeWarnings.Count > 0)
        {
            <div class="range-warning">
                ⚠ @string.Join("；", AutoRangeWarnings)
                @if (_range.Enabled) { <text>请在「选点范围」中补充对应站点类型。</text> }
            </div>
        }

        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px;">
            <button class="btn @(Auto.Running ? "btn-danger" : "btn-primary")" @onclick="ToggleAuto" disabled="@(!Auto.Running && (Container.Busy || OtherTabActive))">
                @(Auto.Running ? "⏹ 停止" : "▶ 启动")
            </button>
            <button class="btn btn-outline btn-sm" @onclick="ClearAutoLogs" disabled="@Auto.Running">🧹 清空日志</button>
            @if (Auto.Running)
            {
                <span class="hint-text">⏳ 轮询中... 已下发 @Auto.Dispatched 个任务</span>
            }
        </div>
    }
    else if (_autoMode == "batch")
    {
        @* ── 批量模式（ContainerTaskService，原「自动容器任务下发」卡片搬入）── *@
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
            <button class="btn @(_containerFlow == 1 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 1'>
                📥 空托盘入库
            </button>
            <button class="btn @(_containerFlow == 2 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 2'>
                📤 带货托盘出库
            </button>
            <button class="btn @(_containerFlow == 3 ? "btn-primary" : "btn-outline")" @onclick='() => _containerFlow = 3'>
                🔀 带货托盘分拣
            </button>
        </div>

        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:10px;">
            <div class="form-group" style="flex:1;min-width:100px;max-width:140px;">
                <label>任务数量</label>
                <input type="number" @bind="_containerCount" min="1" max="100" />
            </div>
            <div class="form-group" style="flex:1;min-width:120px;max-width:180px;">
                <label>下发间隔(秒)</label>
                <input type="number" @bind="_containerInterval" min="0" max="30" step="1">
            </div>
        </div>

        @if (ContainerRangeWarnings.Count > 0)
        {
            <div class="range-warning">
                ⚠ @string.Join("；", ContainerRangeWarnings)
                @if (_range.Enabled) { <text>请在「选点范围」中补充对应站点类型。</text> }
            </div>
        }

        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <button class="btn btn-outline btn-sm" @onclick="RefreshContainerInventory" disabled="@Container.Busy">📋 查询库存</button>
            <button class="btn btn-primary" @onclick="ExecuteContainerAuto" disabled="@(Container.Busy || Auto.Running || OtherTabActive)">
                @(Container.Busy ? $"⏳ 执行中 {Container.Done}/{Container.Total} ..." : "🚀 执行")
            </button>
            @if (Auto.Running)
            {
                <span class="hint-text">轮询运行中，批量执行已禁用</span>
            }
        </div>

        @* 库存缓存（只在批量模式显示；轮询每轮自查，不需要） *@
        @if (Container.EmptyPallets > 0 || Container.LoadedPallets > 0 || Container.Cargos > 0)
        {
            <div class="hint-text" style="margin-top:6px;">
                库存缓存@(_range.Enabled ? "（范围内）" : "（全图）")：空托 @Container.EmptyPallets / 带货托 @Container.LoadedPallets / 货物 @Container.Cargos / 任务可用货物 @Container.PairedCargos
            </div>
        }
    }
    else
    {
        @* ── 纯移动任务（候选池=选点范围，一键自动下发）── *@
        <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:10px;">
            <div class="form-group" style="flex:1;min-width:90px;max-width:120px;">
                <label>下发间隔(秒)</label>
                <input type="number" @bind="_batchInterval" min="0" max="60" step="1">
            </div>
            <div class="form-group" style="flex:1;min-width:150px;max-width:250px;">
                <label>优先级 (0-1000)</label>
                <div style="display:flex;align-items:center;gap:10px;">
                    <input type="range" min="0" max="1000" step="10" @bind="_batchPriority" style="flex:1;">
                    <span style="font-weight:700;color:#38bdf8;min-width:36px;text-align:center;">@_batchPriority</span>
                </div>
            </div>
        </div>
        <div class="hint-text" style="margin-top:-4px;margin-bottom:10px;">
            MOVE_ONLY 纯移动任务，统一自动分配车辆；候选站点取自「选点范围」@(_range.Enabled ? "" : "（未开启 = 全图启用站点）")，当前候选 @_batchPool.Count 个。
        </div>

        <div style="display:flex;gap:10px;margin-top:4px;flex-wrap:wrap;">
            <button class="btn @(_moveRunning ? "btn-danger" : "btn-primary")" @onclick="ToggleMoveDispatch" disabled="@(!_moveRunning && (Auto.Running || Container.Busy || OtherTabActive))">
                @(_moveRunning ? "⏹ 停止自动下发" : "▶ 开始自动下发")
            </button>
            <span class="hint-text" style="margin:0;">每 @_batchInterval 秒在选点范围内随机抽 1 个站点下发 MOVE_ONLY 任务（自动分配车辆），点击停止结束</span>
        </div>
    }
    </div>

    @* 共用尾部：日志区按当前模式显示对应流（轮询→Auto.Logs，批量→Container.Logs，纯移动→_batchLogs）*@
    <div style="border-top:1px solid #334155;margin:14px 0 4px;"></div>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
        <span class="badge-info">@(_autoMode switch { "poll" => "轮询日志", "batch" => "执行日志", _ => "移动任务日志" })</span>
        @if (_autoMode == "poll")
        {
            <button class="btn btn-outline btn-sm" @onclick="ClearAutoLogs" disabled="@Auto.Running">🧹 清空日志</button>
        }
        else if (_autoMode == "batch")
        {
            <button class="btn btn-outline btn-sm" @onclick="ClearContainerLogs" disabled="@Container.Busy">🧹 清空日志</button>
        }
        else
        {
            <button class="btn btn-outline btn-sm" @onclick="ClearBatch">🧹 清空日志</button>
        }
    </div>
    @if (_autoMode == "poll")
    {
        <div style="max-height:360px;overflow-y:auto;font-size:12px;line-height:1.7;font-family:Consolas,monospace;background:#0b1220;border:1px solid #1e293b;border-radius:8px;padding:8px 12px;">
            @foreach (var log in Auto.Logs)
            {
                <div style="color:@log.Color;">@log.Time @log.Message</div>
            }
            @if (Auto.Logs.Count == 0)
            {
                <div class="hint-text">暂无日志，点击「启动」开始轮询储位</div>
            }
        </div>
    }
    else if (_autoMode == "batch")
    {
        <div style="max-height:360px;overflow-y:auto;font-size:12px;line-height:1.7;font-family:Consolas,monospace;background:#0b1220;border:1px solid #1e293b;border-radius:8px;padding:8px 12px;">
            @foreach (var log in Container.Logs)
            {
                <div style="color:@log.Color;">@log.Time @log.Message</div>
            }
            @if (Container.Logs.Count == 0)
            {
                <div class="hint-text">暂无日志，先「查询库存」再「执行」</div>
            }
        </div>
    }
    else
    {
        <div style="max-height:360px;overflow-y:auto;font-size:12px;line-height:1.7;font-family:Consolas,monospace;background:#0b1220;border:1px solid #1e293b;border-radius:8px;padding:8px 12px;">
            @foreach (var log in _batchLogs)
            {
                <div style="color:@log.Color;">@log.Time @log.Message</div>
            }
            @if (_batchLogs.Count == 0)
            {
                <div class="hint-text">暂无日志，点击「随机生成」生成移动任务</div>
            }
        </div>
    }
    }
</div>

@* ════════════════════════════════════════════════
   响应结果：显示最近一次 HTTP 交互的结果与响应 JSON（ShowResp 写入，不持久化）
   ════════════════════════════════════════════════ *@
@if (!string.IsNullOrEmpty(_responseText))
{
    <div class="section-card">
        <div class="response-panel @_respClass">@_responseText</div>
    </div>
}

@code {
    // ── 场景名（后端系统设置，Hub 1s 轮询同步；移动任务报文用）──
    private string SceneName => Hub.Status.Settings.SceneName;

    // ── 地图站点缓存（从「地图信息」页写入的 localStorage 键 grcs_map_stations 恢复，
    //    供按类型筛选候选池与手输站点校验使用）──
    private List<MapStationLite> _mapStations = [];

    // ── 纯移动任务（循环自动下发：每 _batchInterval 秒在选点范围内随机抽站下发 MOVE_ONLY）──
    private int _batchPriority = 50;
    private string _batchOrderIdPrefix = "SimMoveOnly";
    private int _batchInterval = 3;
    private bool _moveRunning;                       // 循环下发运行中标志
    private int _moveSeq;                            // OrderId 递增序号（循环下发的唯一性）
    /// <summary>本标签页唯一 id（跨标签页区分下发发起者，随启停/移动租约请求上传）。
    /// 取服务端已登记的 id（导航往返不换 id，避免把自己的下发误判成"另一标签页"）。</summary>
    private string _tabId = "";
    /// <summary>移动循环取消令牌（页面销毁时中止循环并释放租约，防止租约被孤儿循环永久占用）。</summary>
    private readonly CancellationTokenSource _moveCts = new();
    /// <summary>纯移动任务日志（自动下发明细，模式切到「纯移动任务」时展示）。</summary>
    private readonly List<AutoLogEntry> _batchLogs = [];

    // ── 响应 ──
    private string _responseText = "";
    private string _respClass = "";

    // ── 卡片折叠状态（持久化到 localStorage 键 grcs_auto_collapsed）──
    private Dictionary<string, bool> _collapsed = new() { ["range"] = true, ["auto"] = true };
    private bool IsCollapsed(string key) => _collapsed.GetValueOrDefault(key, true);
    private async Task Toggle(string key)
    {
        _collapsed[key] = !IsCollapsed(key);
        await LocalStore.SetAsync(Js, "grcs_auto_collapsed", JsonSerializer.Serialize(_collapsed));
    }
    private Task ToggleRange() => Toggle("range");
    private Task ToggleAutoSection() => Toggle("auto");

    // ── 选点范围（后端 /api/wcs/auto/range：AutomationTasks 遥控，AutoRunHostedService 执行）──
    private AutoRangeConfig _range = new();
    private string _rangeMarksText = "";
    /// <summary>本页最近一次已同步到后端的范围配置指纹（用于识别「其他标签页改过」）。</summary>
    private string _rangeFp = "";
    /// <summary>范围过滤后的候选池（实时预览用）。</summary>
    private List<MapStationLite> _rangePool => _range.ApplyTo(_mapStations);
    /// <summary>可选楼层：启用站点中符合当前类型过滤的楼层去重排序。</summary>
    private List<int> _rangeAvailableFloors => _mapStations
        .Where(s => s.StaEnable && (_range.TypeFilter == 0 || (s.StationType & _range.TypeFilter) != 0))
        .Select(s => s.Floor).Distinct().OrderBy(f => f).ToList();

    // ── 范围内的各类候选站点（与服务 ApplyRange 同口径：StaEnable + 类型位 + 范围过滤）──
    private List<MapStationLite> _rangeStorages => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.StorageLocation) != 0));
    private List<MapStationLite> _rangeTransferPoints => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.TransferPoint) != 0));
    private List<MapStationLite> _rangePickingStations => _range.ApplyTo(_mapStations.Where(s => s.StaEnable && (s.StationType & MapStationTypeBits.PeopleStation) != 0));

    /// <summary>自动容器任务按当前流程缺的必需站点类型（空 = 可正常下发）。</summary>
    private List<string> ContainerRangeWarnings
    {
        get
        {
            var w = new List<string>();
            if (_containerFlow == 1 || _containerFlow == 2)
            {
                if (_rangeTransferPoints.Count == 0) w.Add("选点范围内没有接驳位，入库/出库任务无法下发");
                if (_rangeStorages.Count == 0) w.Add("选点范围内没有储位，无法确定目标货位");
            }
            else if (_containerFlow == 3)
            {
                if (_rangePickingStations.Count == 0) w.Add("选点范围内没有分拣台，分拣任务无法下发");
            }
            return w;
        }
    }

    /// <summary>自动化（轮询储位）按当前 FlowMode 缺的必需站点类型（空 = 可正常下发）。</summary>
    private List<string> AutoRangeWarnings
    {
        get
        {
            var w = new List<string>();
            if (_rangeTransferPoints.Count == 0) w.Add("选点范围内没有接驳位，空托入库/带货出库无法下发");
            if (_rangeStorages.Count == 0) w.Add("选点范围内没有储位，无法确定目标货位");
            if (Auto.FlowMode != 2 && Auto.FlowMode != 3 && _rangePickingStations.Count == 0) w.Add("选点范围内没有分拣台，分拣流程无法下发");
            return w;
        }
    }

    // ── 跨标签页互斥：其他标签页正在下发 → 本页警示 + 禁止下发操作 ──
    /// <summary>轮询自动化由其他标签页启动。</summary>
    private bool OtherTabPollActive => Auto.Running && !string.IsNullOrEmpty(Hub.Status.AutoTabId) && Hub.Status.AutoTabId != _tabId;
    /// <summary>批量任务由其他标签页发起。</summary>
    private bool OtherTabBatchActive => Container.Busy && !string.IsNullOrEmpty(Hub.Status.BatchTabId) && Hub.Status.BatchTabId != _tabId;
    /// <summary>纯移动任务循环由其他标签页持有租约。</summary>
    private bool OtherTabMoveActive => Hub.Status.MoveRunning && !string.IsNullOrEmpty(Hub.Status.MoveTabId) && Hub.Status.MoveTabId != _tabId;
    /// <summary>是否有其他标签页正在下发（任一模式）。</summary>
    private bool OtherTabActive => OtherTabPollActive || OtherTabBatchActive || OtherTabMoveActive;
    private string OtherTabDesc
    {
        get
        {
            var parts = new List<string>();
            if (OtherTabPollActive) parts.Add("轮询自动化");
            if (OtherTabBatchActive) parts.Add("批量任务");
            if (OtherTabMoveActive) parts.Add("纯移动任务");
            return string.Join("、", parts);
        }
    }

    private void ToggleRangeEnabled() { _range.Enabled = !_range.Enabled; SaveRange(); }
    private void ToggleRangeType(int bit) { _range.TypeFilter ^= bit; SaveRange(); }
    /// <summary>保存选点范围到后端（/api/wcs/auto/range，SQLite 持久化，跨标签页/换浏览器仍在）。</summary>
    private void SaveRange()
    {
        _range.Marks = AutoRangeConfig.ParseMarks(_rangeMarksText);
        // 同步记录指纹：本页刚写入的值不会被 AutomationHub 回显误判为「其他标签页改过」而覆盖
        _rangeFp = RangeFp(_range.Enabled, _range.TypeFilter, _range.FloorFilter, _range.Marks);
        _ = WcsApi.PutAsync<RangeConfigDto, object>("/api/wcs/auto/range", new RangeConfigDto
        {
            Enabled = _range.Enabled,
            TypeFilter = _range.TypeFilter,
            FloorFilter = _range.FloorFilter,
            Marks = _range.Marks,
        });
    }

    /// <summary>范围配置指纹：规范化后比较（Mark 大小写不敏感、去重、排序，避免仅顺序差异造成乒乓刷新）。</summary>
    private static string RangeFp(bool enabled, int typeFilter, int floorFilter, IEnumerable<string> marks)
    {
        var m = string.Join(",", marks
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase));
        return $"{enabled}|{typeFilter}|{floorFilter}|{m}";
    }

    /// <summary>AutomationHub 轮询到范围配置变化（其他标签页改过）时，应用回本页并刷新 UI。</summary>
    private void OnHubChanged()
    {
        var r = Hub.Range;
        var fp = RangeFp(r.Enabled, r.TypeFilter, r.FloorFilter, r.Marks);
        if (fp == _rangeFp) return;
        _range.Enabled = r.Enabled;
        _range.TypeFilter = r.TypeFilter;
        _range.FloorFilter = r.FloorFilter;
        _range.Marks = r.Marks ?? [];
        _rangeMarksText = string.Join(", ", _range.Marks);
        _rangeFp = fp;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>清空手动指定站点输入框并持久化（等价于不限站点，仅保留类型/楼层过滤）。</summary>
    private void ClearRangeMarks()
    {
        _rangeMarksText = "";
        SaveRange();
    }

    /// <summary>
    /// 打开「站点 XY 散点图 + 框选器」（StationMapPicker，纯 JS 实现）。
    /// 数据口径：候选集 = 启用站点 + 当前类型过滤 + 楼层（不含 Marks 白名单自身，
    /// 否则越选越窄）；禁用站点一并传入供置灰展示但不可选。
    /// 确定 → JS 返回选中 Mark 数组 → 写回 _rangeMarksText 并复用 SaveRange 持久化；
    /// 取消返回 null 不改动。再次打开时既有 Mark 自动预选中，可增量编辑。
    /// </summary>
    private async Task OpenStationMapPicker()
    {
        if (_mapStations.Count == 0)
        {
            ShowResp("❌ 请先在「地图信息」页加载地图数据", "error");
            return;
        }

        // 候选站点：类型过滤命中的全部站点（含禁用，供 JS 置灰展示）；白名单不参与过滤
        var stations = _mapStations
            .Where(s => _range.TypeFilter == 0 || (s.StationType & _range.TypeFilter) != 0)
            .Select(s => new StationMapPickerStation
            {
                Mark = s.Mark,
                StationType = s.StationType,
                X = s.X,
                Y = s.Y,
                Floor = s.Floor,
                StaEnable = s.StaEnable,
            })
            .ToList();
        var floors = stations.Where(s => s.StaEnable).Select(s => s.Floor).Distinct().OrderBy(f => f).ToList();
        if (floors.Count == 0)
        {
            ShowResp("❌ 当前类型筛选下没有可用的启用站点", "error");
            return;
        }
        // 范围楼层=全部时默认取最低层，否则取范围楼层（不在候选中时回退最低层）
        int initialFloor = _range.FloorFilter != 0 && floors.Contains(_range.FloorFilter)
            ? _range.FloorFilter
            : floors[0];

        var config = new StationMapPickerConfig
        {
            Floors = floors,
            InitialFloor = initialFloor,
            Stations = stations,
            Preselected = _range.Marks,
        };

        try
        {
            var result = await Js.InvokeAsync<string?>("grcsStationMapPickerOpen", JsonSerializer.Serialize(config));
            if (result == null) return; // 用户取消，不改动
            var marks = JsonSerializer.Deserialize<List<string>>(result, JsonOpts) ?? [];
            _rangeMarksText = string.Join(", ", marks);
            SaveRange();
        }
        catch (Exception ex)
        {
            ShowResp($"❌ 地图框选失败：{ex.Message}", "error");
        }
    }

    // ── 自动化（运行状态/日志在 AutoRunService 单例中，跨导航存活；页面只订阅刷新。
    //    服务内部定时器自己管理生命周期，页面销毁时退订 Changed 事件即可）──
    /// <summary>合并卡片模式：poll=轮询自动化，batch=批量任务。</summary>
    private string _autoMode = "poll";
    private void OnAutoChanged() => InvokeAsync(StateHasChanged);
    private void OnContainerChanged() => InvokeAsync(StateHasChanged);
    /// <summary>退订两个后台服务的状态变化事件，避免组件销毁后回调泄漏；中止移动循环并释放租约。</summary>
    public void Dispose()
    {
        if (_moveRunning)
        {
            _moveRunning = false;
            _moveCts.Cancel();
            _ = WcsApi.PostAsync("/api/wcs/auto/move/stop", new { tabId = _tabId });
        }
        _moveCts.Dispose();
        Auto.Changed -= OnAutoChanged; Container.Changed -= OnContainerChanged; Hub.Changed -= OnHubChanged;
    }
    private Task ToggleAuto() => Auto.ToggleAsync();
    private void ClearAutoLogs() => Auto.ClearLogs();

    // ── 自动容器任务（用户输入参数；执行状态托管到 ContainerTaskService）──
    private int _containerFlow = 1;
    private int _containerCount = 1;
    private int _containerInterval = 3;

    /// <summary>查询 GRCS 库存并缓存到 ContainerTaskService（空托/带货托/货物/任务可用货物计数）。</summary>
    private async Task RefreshContainerInventory()
    {
        await Container.RefreshInventoryAsync();
    }

    private void ClearContainerLogs() => Container.ClearLogs();

    /// <summary>触发 ContainerTaskService 按所选流程执行两段式容器任务，结果回显到响应面板。</summary>
    private async Task ExecuteContainerAuto()
    {
        var result = await Container.ExecuteAsync(_containerFlow, _containerCount, _containerInterval);
        ShowResp(result, result.StartsWith("✅") ? "success" : "error");
    }


    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        // 订阅两个后台服务的状态变化事件：服务状态在单例内变化时通知本页重绘，
        // 页面销毁时在 Dispose 退订，防止泄漏
        Auto.Changed += OnAutoChanged;     // 订阅自动化状态变化（页面销毁时在 Dispose 退订）
        Container.Changed += OnContainerChanged; // 订阅容器任务状态变化
        // 本标签页唯一 id：优先复用服务上已登记的（导航往返不换），再交给两个遥控壳随请求上传
        _tabId = string.IsNullOrEmpty(Auto.TabId) ? Guid.NewGuid().ToString("N") : Auto.TabId;
        Auto.TabId = _tabId;
        Container.TabId = _tabId;

        try
        {
            // 地图站点：单一数据源在后端（/api/wcs/map，地图信息页解析成功后上传）
            var cache = await WcsApi.GetAsync<MapCacheDto>("/api/wcs/map");
            _mapStations = cache?.Stations ?? [];
        }
        catch { }

        try
        {
            var cjson = LocalStore["grcs_auto_collapsed"];
            if (!string.IsNullOrEmpty(cjson) && cjson != "null")
                _collapsed = JsonSerializer.Deserialize<Dictionary<string, bool>>(cjson) ?? _collapsed;
        }
        catch { }

        // 选点范围配置恢复（后端 /api/wcs/auto/range，SQLite 持久化）
        try
        {
            var range = await WcsApi.GetAsync<RangeConfigDto>("/api/wcs/auto/range");
            if (range != null)
            {
                _range.Enabled = range.Enabled;
                _range.TypeFilter = range.TypeFilter;
                _range.FloorFilter = range.FloorFilter;
                _range.Marks = range.Marks ?? [];
                _rangeMarksText = string.Join(", ", _range.Marks);
                _rangeFp = RangeFp(range.Enabled, range.TypeFilter, range.FloorFilter, _range.Marks);
            }
        }
        catch { }

        // 订阅共享轮询中枢：其他标签页改动选点范围（开启/关闭限制、类型/楼层/Mark）时回写本页
        Hub.Changed += OnHubChanged;
    }

    /// <summary>
    /// 纯移动任务候选池：启用站点 + 选点范围约束（类型/楼层/Mark 白名单，与轮询/批量同口径）。
    /// 范围未开启 = 全图启用站点。不再单独选类型/楼层（由选点范围卡片统一管控）。
    /// </summary>
    private List<MapStationLite> _batchPool => _range.ApplyTo(_mapStations.Where(s => s.StaEnable));

    private void ClearBatch()
    {
        _batchLogs.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// 纯移动任务循环下发开关：开始后每 _batchInterval 秒在「选点范围」候选池内
    /// 随机抽 1 个站点下发 MOVE_ONLY 任务（ChangeFloor，自动分配车辆），直到手动停止。
    /// 开始前向后端登记互斥租约（任何下发进行中则拒绝，其他标签页同步被禁）。
    /// </summary>
    private async Task ToggleMoveDispatch()
    {
        if (_moveRunning)
        {
            _moveRunning = false;
            _ = WcsApi.PostAsync("/api/wcs/auto/move/stop", new { tabId = _tabId });
            _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = "⏹ 正在停止自动下发...", Color = "#fbbf24" });
            StateHasChanged();
            return;
        }
        if (string.IsNullOrEmpty(SceneName)) { _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = "❌ 未配置场景名称（地图信息页系统设置）", Color = "#f87171" }); StateHasChanged(); return; }
        var pool = _batchPool;
        if (pool.Count == 0) { _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = "❌ 候选站点池为空（请检查「选点范围」），无法开始", Color = "#f87171" }); StateHasChanged(); return; }

        // 后端互斥登记：未启用（无任何下发进行中）才可下发，并置为启用；被拒则提示
        var lease = await WcsApi.PostAsync<object, MoveLeaseResult>("/api/wcs/auto/move/start", new { tabId = _tabId });
        if (lease is not { Success: true })
        {
            _batchLogs.Add(new AutoLogEntry
            {
                Time = DateTime.Now.ToString("HH:mm:ss"),
                Message = "❌ 无法开始移动下发：" + (lease?.Reason ?? "后端拒绝（互斥：轮询或批量或另一标签页正在下发）"),
                Color = "#f87171"
            });
            StateHasChanged();
            return;
        }

        _moveRunning = true;
        _moveSeq = 0;
        _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = $"▶ 开始自动下发：每 {_batchInterval} 秒随机下发 1 个纯移动任务（候选池 {pool.Count} 个，选点范围{(_range.Enabled ? "已开启" : "未开启=全图")}）", Color = "#60a5fa" });
        StateHasChanged();
        _ = MoveDispatchLoopAsync();
        _ = MoveHeartbeatAsync();
    }

    /// <summary>移动循环属主心跳：每 5s 续约一次，防止本标签页被关闭后租约永久占用其他页。</summary>
    private async Task MoveHeartbeatAsync()
    {
        while (_moveRunning && !_moveCts.IsCancellationRequested)
        {
            try { await Task.Delay(5000, _moveCts.Token); } catch { return; }
            if (!_moveRunning) break;
            _ = WcsApi.PostAsync("/api/wcs/auto/move/beat", new { tabId = _tabId });
        }
    }

    private async Task MoveDispatchLoopAsync()
    {
        while (_moveRunning && !_moveCts.IsCancellationRequested)
        {
            var pool = _batchPool;
            if (pool.Count == 0)
            {
                _moveRunning = false;
                _ = WcsApi.PostAsync("/api/wcs/auto/move/stop", new { tabId = _tabId });
                _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = "❌ 候选站点池为空（请检查「选点范围」），自动下发已停止", Color = "#f87171" });
                StateHasChanged();
                return;
            }

            var st = pool[Random.Shared.Next(pool.Count)];
            var payload = new VehicleOrderRequest
            {
                CreateTime = DateTime.Now,
                SceneName = SceneName,
                OrderType = "MOVE_ONLY",
                OrderId = $"{_batchOrderIdPrefix}_{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString("x").ToUpper()}_{++_moveSeq}",
                OrderName = "wcs模拟器纯移动任务",
                VehicleName = null,
                Priority = _batchPriority,
                StationCodes = [st.Mark],
            };

            var resp = await WcsApi.PostAsync<object, MoveDispatchResult>("/api/wcs/auto/move/dispatch", payload);
            var ok = resp?.Success == true;
            var code = resp?.Code ?? 0;
            var json = resp?.Json ?? "";
            _batchLogs.Add(new AutoLogEntry
            {
                Time = DateTime.Now.ToString("HH:mm:ss"),
                Message = (ok ? "✓ " : "❌ ") + $"#{_moveSeq:000}  {st.Mark}  [{TypeLabel(st.StationType)}]  " + (ok ? "下发成功" : $"下发失败 HTTP {code}"),
                Color = ok ? "#4ade80" : "#f87171"
            });
            StateHasChanged();

            if (!_moveRunning) break;
            try { await Task.Delay(_batchInterval * 1000, _moveCts.Token); } catch { break; }
        }
        _moveRunning = false;
        _batchLogs.Add(new AutoLogEntry { Time = DateTime.Now.ToString("HH:mm:ss"), Message = "⏹ 自动下发已停止", Color = "#fbbf24" });
        StateHasChanged();
    }

    /// <summary>站点类型位掩码 → 中文类型名（多类型用 + 连接；0=手输站点无类型）。</summary>
    private static string TypeLabel(int t) => t == 0 ? "手输" : string.Join("+", MapStationTypeBits.DecodeNames(t));

    /// <summary>把最近一次 HTTP 交互结果写入响应面板。</summary>
    private void ShowResp(string msg, string cls) { _responseText = msg; _respClass = cls; }
}
