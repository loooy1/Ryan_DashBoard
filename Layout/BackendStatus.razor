@inject HttpClient Http
@inject NavigationManager NavManager
@implements IDisposable

@* ════════════════════════════════════════════════
   项目导航底部连接状态（独立组件）。

   为什么独立成组件：Blazor 里父组件调用 StateHasChanged 会连带重渲染整棵子树。
   优化前探测逻辑写在 MainLayout 里，每 15 秒探测一次两个后端后重渲染布局，
   当前正在渲染的页面（@Body）也跟着整树重渲染，交互多时能感觉到卡顿。
   独立后只有本组件每 15 秒重渲染自己，页面树完全不受影响。

   探测语义：能拿到任何 HTTP 状态码就算在线（不关心业务响应内容）；
   3 秒内无响应视为离线（短超时让"离线红点"出现得更快，全局 HttpClient 的
   10s 超时在这里不适用，故用本组件的 CancellationTokenSource 单独控制）。
   null=未知（首次探测前）/ true=在线 / false=离线。
   ════════════════════════════════════════════════ *@
<div class="sidebar-status">
    <div class="ss-card" title="WCS 后端管理接口 — http://localhost:8230">
        <span class="ss-dot @DotClass(_wcsOnline)"></span>
        <span class="ss-name">WCS 后端</span>
        <span class="ss-state @DotStateClass(_wcsOnline)">@DotStateText(_wcsOnline)</span>
        <span class="ss-port">8230</span>
    </div>
    <div class="ss-card" title="GRCS 后端接口 — http://localhost:8224">
        <span class="ss-dot @DotClass(_grcsOnline)"></span>
        <span class="ss-name">GRCS 后端</span>
        <span class="ss-state @DotStateClass(_grcsOnline)">@DotStateText(_grcsOnline)</span>
        <span class="ss-port">8224</span>
    </div>
    <div class="ss-front" title="WCS 前端当前运行地址">前端 · @NavManager.BaseUri</div>
</div>

@code {
    // null=未知 / true=在线 / false=离线
    private bool? _wcsOnline;
    private bool? _grcsOnline;
    private System.Threading.Timer? _probeTimer;
    private const string WcsProbeUrl = "http://localhost:8230/api/wcs/status";
    private const string GrcsProbeUrl = "http://localhost:8224/";
    private static readonly TimeSpan ProbeTimeout = TimeSpan.FromSeconds(3);  // 探测短超时，离线快速变红点

    protected override async Task OnInitializedAsync()
    {
        await ProbeEndpointsAsync();
        // 每 15 秒刷新一次连接状态（端点故障时自动变红点）
        _probeTimer = new System.Threading.Timer(async _ => await ProbeEndpointsAsync(),
            null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task ProbeEndpointsAsync()
    {
        _wcsOnline = await ProbeAsync(WcsProbeUrl);
        _grcsOnline = await ProbeAsync(GrcsProbeUrl);
        StateHasChanged();
    }

    /// <summary>探测一个端点：能建立 HTTP 连接（拿到任何状态码）就算在线；3 秒无响应视为离线。</summary>
    private async Task<bool?> ProbeAsync(string url)
    {
        try
        {
            using var cts = new CancellationTokenSource(ProbeTimeout);
            using var resp = await Http.GetAsync(url, HttpCompletionOption.ResponseHeadersRead, cts.Token);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string DotClass(bool? online) => online switch
    {
        true => "on",
        false => "off",
        null => ""
    };

    private static string DotStateText(bool? online) => online switch
    {
        true => "在线",
        false => "离线",
        null => "检测中"
    };

    private static string DotStateClass(bool? online) => online switch
    {
        true => "on",
        false => "off",
        null => "probe"
    };

    public void Dispose()
    {
        _probeTimer?.Dispose();
        _probeTimer = null;
    }
}
