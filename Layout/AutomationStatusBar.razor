@inject AutoRunService Auto
@inject ContainerTaskService Container
@inject SignalAutoService Signal
@implements IDisposable

@* ════════════════════════════════════════════════
   自动化状态栏：固定在主布局底部，跨模块始终可见
   显示 AutoRunService / ContainerTaskService / SignalAutoService 的运行状态
   ════════════════════════════════════════════════ *@
<div class="auto-status-bar @(HasActivity ? "active" : "")">
    @* ── 自动化：运行状态 ── *@
    <div class="asb-section" title="自动化轮询储位：
@(Auto.Running ? "▶ 运行中" : "⏸ 已停止")
已下发 @Auto.Dispatched 个任务
间隔 @Auto.Interval 秒">
        <span class="asb-dot @(Auto.Running ? "on" : "")"></span>
        <span class="asb-label">自动化</span>
        <span class="asb-val @(Auto.Running ? "on" : "")">@(Auto.Running ? "▶ 运行中" : "⏸ 已停止")</span>
    </div>

    <span class="asb-sep">│</span>

    @* ── 容器：空托数 / 带货托数 ── *@
    <div class="asb-section" title="容器库存缓存：
空托 @Container.EmptyPallets 个
带货托 @Container.LoadedPallets 个">
        <span class="asb-dot @(Container.Busy ? "busy" : "")"></span>
        <span class="asb-label">容器</span>
        <span class="asb-meta">空托 <b>@Container.EmptyPallets</b></span>
        <span class="asb-meta">带货托 <b>@Container.LoadedPallets</b></span>
    </div>

    <span class="asb-sep">│</span>

    @* ── 信号自动：到达 / 移除 / 分拣 ── *@
    <div class="asb-section" title="信号自动确认：
到达自动@(Signal.ArrivalAuto ? " ✓ 开启" : " ✗ 关闭")
移除自动@(Signal.RemovalAuto ? " ✓ 开启" : " ✗ 关闭")
分拣自动@(Signal.AutoSend ? " ✓ 开启" : " ✗ 关闭")">
        <span class="asb-dot @(Signal.Running && (Signal.ArrivalAuto || Signal.RemovalAuto || Signal.AutoSend) ? "on" : "")"></span>
        <span class="asb-label">信号自动</span>
        <span class="asb-chip @(Signal.ArrivalAuto ? "chip-on" : "")">到达@(Signal.ArrivalAuto ? " ✓" : "")</span>
        <span class="asb-chip @(Signal.RemovalAuto ? "chip-on" : "")">移除@(Signal.RemovalAuto ? " ✓" : "")</span>
        <span class="asb-chip @(Signal.AutoSend ? "chip-on" : "")">分拣@(Signal.AutoSend ? " ✓" : "")</span>
    </div>
</div>

@code {
    private bool HasActivity => Auto.Running || Container.Busy || Signal.Running;

    protected override void OnInitialized()
    {
        Auto.Changed += OnChanged;
        Container.Changed += OnChanged;
        Signal.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auto.Changed -= OnChanged;
        Container.Changed -= OnChanged;
        Signal.Changed -= OnChanged;
    }
}
